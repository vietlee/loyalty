<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta name="turbo-cache-control" content="no-cache">
    <%= render "layouts/head" %>
  </head>
  <body>
    <%= render "layouts/merchant_theme_vars" %>

    <div class="l-shell">
      <%= render "layouts/merchant_sidebar" %>
      <main class="l-main">
        <header class="l-topbar">
          <div class="title">
            <%= content_for?(:title) ? yield(:title) : "Tổng quan" %>
            <span class="en"><%= content_for?(:title_en) ? yield(:title_en) : "OVERVIEW" %></span>
          </div>
          <div style="margin-left:auto;">
            <span style="display:inline-flex; border:1px solid var(--line); border-radius:999px; overflow:hidden;">
              <% [["VI", :vi], ["EN", :en]].each do |lbl, loc| %>
                <% on = I18n.locale == loc %>
                <%= link_to lbl, set_locale_path(loc),
                      style: "padding:6px 16px; font-size:12px; font-weight:700; text-decoration:none; #{on ? 'background:var(--primary); color:var(--on-primary);' : 'color:var(--ink-2);'}" %>
              <% end %>
            </span>
          </div>
        </header>
        <div class="l-content"><%= yield %></div>
      </main>
    </div>
  </body>
</html>
