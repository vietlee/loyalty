<% primary = (current_workspace&.theme_value(:primary).presence || "#8C4A2F") %>
<% surface = (current_workspace&.theme_value(:surface).presence || "#FBF6EF") %>
<div id="l-splash" class="l-splash" role="status" aria-label="Đang tải…">
  <div class="l-splash-mark">
    <div class="l-splash-ring"></div>
    <div class="l-splash-badge">
      <% if current_workspace&.logo&.attached? %>
        <img src="<%= workspace_icon_url(current_workspace) %>" alt="">
      <% else %>
        <span><%= (current_workspace&.name.to_s.strip[0, 1].presence || "❤").upcase %></span>
      <% end %>
    </div>
  </div>
</div>
<style>
  .l-splash{position:fixed;inset:0;z-index:99999;display:grid;place-items:center;
    background:<%= surface %>;transition:opacity .4s ease;}
  .l-splash.l-splash-hide{opacity:0;pointer-events:none;}
  .l-splash-mark{position:relative;display:grid;place-items:center;width:120px;height:120px;}
  .l-splash-ring{position:absolute;inset:0;border-radius:50%;
    border:3px solid <%= primary %>2e;border-top-color:<%= primary %>;
    animation:l-splash-spin 1s linear infinite;}
  .l-splash-badge{position:relative;width:78px;height:78px;border-radius:22px;overflow:hidden;
    display:grid;place-items:center;background:<%= primary %>;color:#fff;
    font-family:Georgia,"Times New Roman",serif;font-weight:700;font-size:32px;line-height:1;
    box-shadow:0 12px 32px rgba(0,0,0,.16);animation:l-splash-pop 1s ease-in-out infinite alternate;}
  .l-splash-badge img{width:100%;height:100%;object-fit:cover;}
  @keyframes l-splash-spin{to{transform:rotate(360deg);}}
  @keyframes l-splash-pop{from{transform:scale(.92);}to{transform:scale(1.06);}}
  @media (prefers-reduced-motion:reduce){.l-splash-ring,.l-splash-badge{animation:none;}}
</style>
<script>
  (function () {
    var s = document.getElementById("l-splash");
    if (!s) return;
    var hidden = false;
    function hide() {
      if (hidden) return; hidden = true;
      s.classList.add("l-splash-hide");
      setTimeout(function () { if (s && s.parentNode) s.parentNode.removeChild(s); }, 450);
    }
    if (document.readyState === "complete") setTimeout(hide, 250);
    else window.addEventListener("load", function () { setTimeout(hide, 250); });
    setTimeout(hide, 6000); // safety net — never trap the user behind the splash
  })();
</script>
