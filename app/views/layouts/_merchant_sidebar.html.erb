<% nav = defined?(nav_key) ? nav_key : nil %>
<aside class="l-side" data-controller="activenav">
  <div class="brand">
    <div class="logo"><%= current_workspace&.logo_initials || "DL" %></div>
    <div>
      <div class="nm"><%= current_workspace&.name || "Dynamic Loyalty" %></div>
      <div class="sub"><%= t("merchant.nav.merchant_tag") %></div>
    </div>
  </div>

  <% if accessible_workspaces.size > 1 %>
    <details class="l-ws">
      <summary style="cursor:pointer; list-style:none;">
        <div class="k"><%= t("merchant.nav.workspace") %></div>
        <div class="v"><%= current_workspace&.name %> ▾</div>
      </summary>
      <div style="margin-top:8px; display:flex; flex-direction:column; gap:4px;">
        <% accessible_workspaces.each do |ws| %>
          <%= button_to ws.name, merchant_switch_workspace_path(ws), class: "l-nav-item",
                style: "background:none;border:none;text-align:left;width:100%;#{'font-weight:700;' if ws.id == current_workspace&.id}" %>
        <% end %>
      </div>
    </details>
  <% else %>
    <div class="l-ws"><div class="k"><%= t("merchant.nav.workspace") %></div><div class="v"><%= current_workspace&.name %></div></div>
  <% end %>

  <div class="l-navgrp"><%= t("merchant.nav.group_ops") %></div>
  <%= link_to merchant_root_path, class: "l-nav-item #{'active' if nav == :dashboard}" do %>
    <span>▣</span><span><%= t("merchant.nav.dashboard") %></span>
  <% end %>
  <% if current_membership&.can_manage? %>
    <%= link_to merchant_outlets_path, class: "l-nav-item #{'active' if nav == :outlets}" do %>
      <span>⌂</span><span><%= t("merchant.nav.outlets") %></span>
    <% end %>
  <% end %>
  <%= link_to merchant_scanner_path, class: "l-nav-item #{'active' if nav == :scanner}" do %>
    <span>⧉</span><span><%= t("merchant.nav.scanner") %></span>
  <% end %>
  <%= link_to merchant_customers_path, class: "l-nav-item #{'active' if nav == :customers}" do %>
    <span>☺</span><span><%= t("merchant.nav.customers") %></span>
  <% end %>
  <% if current_membership&.can_manage? %>
  <%= link_to merchant_broadcasts_path, class: "l-nav-item #{'active' if nav == :broadcasts}" do %>
    <span>✉</span><span><%= t("merchant.nav.broadcasts") %></span>
  <% end %>
  <%= link_to merchant_rewards_path, class: "l-nav-item #{'active' if nav == :rewards}" do %>
    <span>🎁</span><span><%= t("merchant.nav.rewards") %></span>
  <% end %>
  <%= link_to merchant_campaigns_path, class: "l-nav-item #{'active' if nav == :campaigns}" do %>
    <span>◈</span><span><%= t("merchant.nav.campaigns") %></span>
  <% end %>
  <%= link_to merchant_gamification_path, class: "l-nav-item #{'active' if nav == :gamification}" do %>
    <span>🎯</span><span><%= t("merchant.nav.gamification") %></span>
  <% end %>
  <%= link_to merchant_feedback_path, class: "l-nav-item #{'active' if nav == :feedback}" do %>
    <span>⭐</span><span><%= t("merchant.nav.feedback") %></span>
  <% end %>

  <div class="l-navgrp"><%= t("merchant.nav.group_config") %></div>
  <%= link_to merchant_loyalty_program_path, class: "l-nav-item #{'active' if nav == :program}" do %>
    <span>◉</span><span><%= t("merchant.nav.program") %></span>
  <% end %>
  <%= link_to merchant_appearance_path, class: "l-nav-item #{'active' if nav == :appearance}" do %>
    <span>◐</span><span><%= t("merchant.nav.appearance") %></span>
  <% end %>
  <%= link_to merchant_staff_index_path, class: "l-nav-item #{'active' if nav == :staff}" do %>
    <span>☻</span><span><%= t("merchant.nav.staff") %></span>
  <% end %>
  <%= link_to merchant_domain_path, class: "l-nav-item #{'active' if nav == :domain}" do %>
    <span>◍</span><span><%= t("merchant.nav.domain") %></span>
  <% end %>
  <%= link_to merchant_billing_path, class: "l-nav-item #{'active' if nav == :billing}" do %>
    <span>◇</span><span><%= t("merchant.nav.billing") %></span>
  <% end %>
  <% end %>

  <div style="margin-top:14px; padding:0 4px;">
    <div class="l-navgrp" style="margin-bottom:6px;"><%= t("merchant.nav.language") %></div>
    <span style="display:inline-flex; border:1px solid rgba(255,255,255,.16); border-radius:999px; overflow:hidden;">
      <% [["VI", :vi], ["EN", :en]].each do |lbl, loc| %>
        <% on = I18n.locale == loc %>
        <%= link_to lbl, set_locale_path(loc),
              style: "padding:5px 14px; font-size:12px; font-weight:700; text-decoration:none; #{on ? 'background:var(--primary); color:var(--on-primary);' : 'color:#EDE4D8; opacity:.7;'}" %>
      <% end %>
    </span>
  </div>

  <div class="foot">
    <%= link_to merchant_account_path, style: "display:flex; align-items:center; gap:10px; flex:1; min-width:0; text-decoration:none; color:inherit; border-radius:10px; padding:4px 6px; #{'background:rgba(255,255,255,.1);' if nav == :account}", title: t("merchant.nav.account") do %>
      <div class="av"><%= current_user&.initials %></div>
      <div style="min-width:0;">
        <div style="font-size:13px; font-weight:600;"><%= current_user&.name %></div>
        <div style="font-size:11px; opacity:.6;"><%= current_membership&.label %></div>
      </div>
    <% end %>
    <%= button_to "⎋", destroy_user_session_path, method: :delete,
          form: { data: { turbo_confirm: t("merchant.nav.logout_confirm") } },
          style: "margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;font-size:16px;" %>
  </div>
</aside>
