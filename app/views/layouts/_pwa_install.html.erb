<div class="l-a2hs" data-pwa-target="installBanner" hidden>
  <div class="ic">📲</div>
  <div style="flex:1; min-width:0;">
    <div style="font-weight:700; font-size:14px;"><%= t("customer.pwa.install_title") %></div>
    <div style="font-size:12px; color:var(--ink-2);"><%= t("customer.pwa.install_sub") %></div>
    <div data-pwa-target="iosHint" hidden style="font-size:12px; color:var(--ink-2); margin-top:4px;"><%= t("customer.pwa.ios_hint") %></div>
  </div>
  <button type="button" class="l-btn l-btn-primary" data-pwa-target="installButton" data-action="pwa#install"
          style="padding:8px 14px; font-size:13px; flex:none;"><%= t("customer.pwa.install_btn") %></button>
  <button type="button" class="l-a2hs-x" data-action="pwa#dismissInstall" aria-label="Đóng">✕</button>
</div>
