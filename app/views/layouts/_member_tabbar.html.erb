<% key = content_for(:tab).to_s.strip.presence %>
<nav class="l-tabbar">
 <div class="l-tabbar-inner">
  <%= link_to member_root_path, class: ("active" if key == "home") do %>
    <%= ui_icon(:home, size: 22) %><span>Trang chủ</span>
  <% end %>
  <%= link_to member_wallet_path, class: ("active" if key == "wallet") do %>
    <%= ui_icon(:gift, size: 22) %><span>Ví thưởng</span>
  <% end %>
  <%= link_to member_scan_path, class: "scan-fab", "aria-label": "Quét mã" do %>
    <%= ui_icon(:scan, size: 26) %>
  <% end %>
  <%= link_to member_my_code_path, class: ("active" if key == "code") do %>
    <%= ui_icon(:qrcode, size: 22) %><span>Mã của tôi</span>
  <% end %>
  <%= link_to member_profile_path, class: ("active" if key == "me") do %>
    <%= ui_icon(:user, size: 22) %><span>Cá nhân</span>
  <% end %>
 </div>
</nav>
