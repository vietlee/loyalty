<% key = content_for(:tab).to_s.strip.presence %>
<nav class="l-tabbar">
 <div class="l-tabbar-inner">
  <%= link_to member_root_path, class: ("active" if key == "home") do %>
    <%= ui_icon(:home, size: 22) %><span><%= t("customer.nav.home") %></span>
  <% end %>
  <%= link_to member_wallet_path, class: ("active" if key == "wallet") do %>
    <%= ui_icon(:gift, size: 22) %><span><%= t("customer.nav.wallet") %></span>
  <% end %>
  <%= link_to member_scan_path, class: "scan-fab", "aria-label": t("customer.nav.scan") do %>
    <%= ui_icon(:scan, size: 34) %>
  <% end %>
  <%= link_to member_my_code_path, class: ("active" if key == "code") do %>
    <%= ui_icon(:qrcode, size: 22) %><span><%= t("customer.nav.my_code") %></span>
  <% end %>
  <%= link_to member_profile_path, class: ("active" if key == "me") do %>
    <%= ui_icon(:user, size: 22) %><span><%= t("customer.nav.me") %></span>
  <% end %>
 </div>
</nav>
