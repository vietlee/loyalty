<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta name="turbo-cache-control" content="no-cache">
    <%= render "layouts/head" %>
  </head>
  <body>
    <%= render "layouts/merchant_theme_vars" %>

    <div style="min-height:100dvh; display:flex; flex-direction:column; background:var(--surface); color:var(--ink);">
      <%# ---- Slim kiosk header: shop identity + branch + logout, no menu ---- %>
      <header style="display:flex; align-items:center; gap:12px; padding:12px 16px;
                     background:var(--primary); color:var(--on-primary); position:sticky; top:0; z-index:10;">
        <%= link_to merchant_scan_home_path, data: { turbo: false },
              style: "display:flex; align-items:center; gap:10px; text-decoration:none; color:inherit; min-width:0;" do %>
          <div style="width:38px; height:38px; border-radius:11px; overflow:hidden; flex:none;
                      background:rgba(255,255,255,.18); display:grid; place-items:center;">
            <% if current_workspace.logo.attached? %>
              <%= image_tag url_for(current_workspace.logo), style: "width:100%; height:100%; object-fit:cover;" %>
            <% else %>
              <span style="font-family:var(--font-display); font-weight:800; font-size:16px;"><%= current_workspace.logo_initials %></span>
            <% end %>
          </div>
          <div style="min-width:0;">
            <div style="font-weight:800; font-size:15px; line-height:1.1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= current_workspace.name %></div>
            <div style="font-size:11px; opacity:.85; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
              <%= current_user&.name %><% if current_outlet %> · <%= current_outlet.name %><% end %>
            </div>
          </div>
        <% end %>

        <span style="margin-left:auto; display:inline-flex; border:1px solid rgba(255,255,255,.4); border-radius:999px; overflow:hidden; flex:none;">
          <% [["VI", :vi], ["EN", :en]].each do |lbl, loc| %>
            <% on = I18n.locale == loc %>
            <%= link_to lbl, set_locale_path(loc),
                  style: "padding:5px 11px; font-size:11px; font-weight:700; text-decoration:none; #{on ? 'background:#fff; color:var(--primary);' : 'color:var(--on-primary);'}" %>
          <% end %>
        </span>
      </header>

      <main style="flex:1; padding:18px 16px 40px;">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
