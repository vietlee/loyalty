<% content_for :title, t("customer.badges.title") %>
<% content_for :tab, "" %>
<header class="l-appbar">
  <%= link_to "←", member_root_path, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:22px;"><%= t("customer.badges.title") %></div>
  <span class="l-chip l-chip-brand" style="margin-left:auto;"><%= @earned.size %>/<%= @badges.size %></span>
</header>

<div class="l-screen">
  <% if @badges.empty? %>
    <div class="l-tile" style="text-align:center; padding:40px 20px;"><div style="font-size:40px;">🏅</div><p style="font-weight:600; margin-top:8px;"><%= t("customer.badges.empty") %></p></div>
  <% else %>
    <div class="l-badge-grid">
      <% @badges.each do |b| %>
        <% earned = @earned.include?(b.id) %>
        <div class="l-badge <%= 'locked' unless earned %>">
          <div class="ic"><%= earned ? b.display_icon : "🔒" %></div>
          <div class="nm"><%= b.name %></div>
          <% if b.description.present? %>
            <div style="font-size:10px; color:var(--ink-2); margin-top:2px;"><%= b.description %></div>
          <% end %>
          <div style="font-size:10px; color:var(--ink-2); margin-top:4px; display:flex; flex-direction:column; gap:2px; align-items:center;">
            <span>🎯 <%= b.requirement_text %></span>
            <% if b.reward_points.to_i.positive? %>
              <span style="color:var(--primary);">🎁 <%= t("customer.badges.reward_hint", n: b.reward_points) %></span>
            <% end %>
            <% if earned %><span style="color:var(--good,#2E9E5B); font-weight:600;"><%= t("customer.badges.earned") %></span><% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
