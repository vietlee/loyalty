<% content_for :title, "Thông báo" %>
<% content_for :tab, "" %>
<header class="l-appbar">
  <%= link_to "←", member_root_path, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:22px;">Thông báo</div>
</header>

<div class="l-screen">
  <% if @notifications.empty? %>
    <div class="l-tile" style="text-align:center; padding:40px 20px;">
      <div style="font-size:40px;">🔔</div>
      <p style="font-weight:600; margin-top:8px;">Chưa có thông báo</p>
      <p style="color:var(--ink-2); font-size:13px;">Ưu đãi và nhắc nhở sẽ hiện ở đây.</p>
    </div>
  <% else %>
    <% @notifications.each do |n| %>
      <div class="l-tile" style="display:flex; gap:12px; margin-bottom:10px; <%= 'border-left:3px solid var(--primary);' unless n.read? %>">
        <div style="width:42px; height:42px; border-radius:14px; background:var(--surface-2); display:grid; place-items:center; font-size:20px; flex:none;"><%= n.display_icon %></div>
        <div style="flex:1; min-width:0;">
          <div style="font-weight:700;"><%= n.title %></div>
          <div style="font-size:13px; color:var(--ink-2); margin-top:2px;"><%= n.body %></div>
          <div style="font-size:11px; color:var(--ink-3, var(--ink-2)); margin-top:6px;"><%= time_ago_in_words(n.created_at) %> trước</div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
