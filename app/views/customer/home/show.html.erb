<% content_for :title, current_workspace.name %>
<% content_for :tab, "home" %>
<% tier = @tier %>

<header class="l-appbar">
  <%= workspace_avatar(current_workspace) %>
  <div style="min-width:0;">
    <div class="nm"><%= current_workspace.name %></div>
    <div class="hi"><%= t("customer.home.greeting", name: @member.name.presence || current_workspace.branding_value("customer_term")) %></div>
  </div>
  <div style="margin-left:auto; display:flex; align-items:center; gap:14px; color:var(--ink);">
    <%= link_to member_notifications_path, style: "position:relative; text-decoration:none; color:inherit; display:grid; place-items:center;" do %>
      <%= ui_icon(:bell, size: 22) %><% if @unread.to_i.positive? %><span style="position:absolute; top:-5px; right:-6px; background:var(--warn); color:#fff; font-size:10px; font-weight:700; min-width:16px; height:16px; border-radius:999px; display:grid; place-items:center; padding:0 4px;"><%= @unread %></span><% end %>
    <% end %>
  </div>
</header>

<div class="l-screen">
  <%# ---- Membership card (theme-coloured, tier as badge) → tier journey ---- %>
  <%= link_to member_tier_path, style: "text-decoration:none; color:#fff; display:block;" do %>
    <div class="l-card" style="--tier-from: var(--primary); --tier-to: color-mix(in srgb, var(--primary) 52%, #000);">
      <% if tier %>
        <div class="tier-badge" style="background:<%= tier.gradient_css %>;"><span class="medal">👑</span><%= t("customer.home.tier_badge", name: tier.name) %></div>
      <% end %>
      <div class="k" style="<%= 'margin-top:44px;' if tier %>"><%= t("customer.home.points_balance") %></div>
      <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:12px;">
        <div class="pts"><%= number_with_delimiter(@member.points_balance) %></div>
        <div style="text-align:right; opacity:.85; font-size:12px; padding-bottom:8px;">
          <% if tier && tier.multiplier.to_f > 1 %><%= t("customer.home.per_bill_html", m: tier.multiplier) %><% else %><%= current_workspace.program.earn_rate_label %><% end %>
        </div>
      </div>
      <div class="name"><%= @member.display_name.upcase %></div>
      <div class="meta">MEMBER · <%= @member.phone %></div>
    </div>
  <% end %>

  <%# ---- Quick actions — engaging shortcuts (My code + Scan already live in the
        tab bar, so we promote reward/progress/game features here instead). ---- %>
  <% prog = current_workspace.program %>
  <%
    tiles = []
    tiles << [:tier,          member_tier_path,          :medal,   t("customer.home.q_tier")]
    tiles << [:wallet,        member_wallet_path,        :gift,    t("customer.home.q_wallet")]
    tiles << [:wheel,         member_wheel_path,         :wheel,   t("customer.home.q_wheel")]     if prog.gamification_enabled
    tiles << [:missions,      member_missions_path,      :target,  t("customer.home.q_missions")]  if prog.gamification_enabled
    tiles << [:refer,         member_refer_path,         :users,   t("customer.home.q_invite")]    if prog.referral_enabled
    tiles << [:history,       member_history_path,       :history, t("customer.home.q_history")]
    tiles << [:notifications, member_notifications_path, :bell,    t("customer.home.q_notifications")]
    tiles = tiles.first(4)
    used  = tiles.map(&:first)
  %>
  <div class="l-quick">
    <% tiles.each do |_key, path, icon, label| %>
      <%= link_to path do %><span class="ic"><%= ui_icon(icon, size: 26) %></span><%= label %><% end %>
    <% end %>
  </div>

  <%# ---- Secondary chips: only features NOT already promoted into the tiles ---- %>
  <%
    chips = []
    if prog.gamification_enabled
      chips << [member_stamps_path,   :stamp,  t("customer.home.chip_stamps")] if @has_stamps
      chips << [member_missions_path, :target, t("customer.home.chip_missions")] unless used.include?(:missions)
      chips << [member_badges_path,   :medal,  t("customer.home.chip_badges")]
    end
    chips << [member_refer_path, :users, t("customer.home.chip_refer")] if prog.referral_enabled && !used.include?(:refer)
  %>
  <% if chips.any? %>
    <div style="display:flex; gap:8px; margin-top:12px; justify-content:center; flex-wrap:wrap;">
      <% chips.each do |path, icon, label| %>
        <%= link_to path, class: "l-chip l-chip-lg", style: "flex:none;" do %><%= ui_icon(icon, size: 20) %> <%= label %><% end %>
      <% end %>
    </div>
  <% end %>

  <%# ---- Offers carousel (demo content; wired in later phases) ---- %>
  <div class="l-section-h"><h3><%= t("customer.home.offers_title", term: current_workspace.branding_value("customer_term")) %></h3><%= link_to t("customer.common.all"), member_wallet_path %></div>
  <div data-controller="carousel">
    <div class="l-carousel" data-carousel-target="track">
      <div class="l-offer"><div class="l-eyebrow" style="color:#fff; opacity:.85;"><%= t("customer.home.offer_gold_eyebrow") %></div><div class="big"><%= t("customer.home.offer_gold_big") %></div><div style="font-size:12.5px; opacity:.9;"><%= t("customer.home.offer_gold_sub") %></div></div>
      <div class="l-offer" style="background:linear-gradient(135deg,#3F7A57,#2C5A3E);"><div class="l-eyebrow" style="color:#fff; opacity:.85;"><%= t("customer.home.offer_bday_eyebrow") %></div><div class="big"><%= t("customer.home.offer_bday_big") %></div><div style="font-size:12.5px; opacity:.9;"><%= t("customer.home.offer_bday_sub") %></div></div>
      <div class="l-offer" style="background:linear-gradient(135deg,#4B9FE1,#3574B0);"><div class="l-eyebrow" style="color:#fff; opacity:.85;"><%= t("customer.home.offer_refer_eyebrow") %></div><div class="big"><%= t("customer.home.offer_refer_big") %></div><div style="font-size:12.5px; opacity:.9;"><%= t("customer.home.offer_refer_sub") %></div></div>
    </div>
    <div class="l-dots" data-carousel-target="dots"></div>
  </div>

  <%# ---- Today's missions ---- %>
  <% if @missions&.any? %>
    <div class="l-section-h"><h3><%= t("customer.home.missions_today") %></h3><%= link_to t("customer.common.all"), member_missions_path %></div>
    <div class="l-tile">
      <% @missions.each do |m| %>
        <% mp = @progress[m] %>
        <div class="l-check <%= 'done' if mp.completed? %>">
          <span class="box"><%= "✓" if mp.completed? %></span>
          <div style="flex:1;"><div style="font-weight:600;"><%= m.display_icon %> <%= m.title %></div><div style="font-size:12px; color:var(--ink-2);"><%= t("customer.common.points_plus", n: m.reward_points) %></div></div>
          <% if !mp.completed? && m.mission_type == "checkin" %>
            <%= link_to t("customer.common.checkin"), member_scan_path, class: "l-btn l-btn-soft", style: "padding:6px 12px; font-size:12px;" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
