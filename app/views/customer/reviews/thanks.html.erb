<% content_for :title, t("customer.review_thanks.title") %>
<% content_for :tab, "" %>
<% happy = @rating.stars >= 4 %>
<% google = current_workspace.google_review_url %>

<header class="l-appbar">
  <%= link_to "←", (current_workspace.feedback_public? ? member_shop_about_path : member_root_path),
        style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:22px;"><%= t("customer.review_thanks.title") %></div>
</header>

<div class="l-screen">
  <div class="l-tile" style="text-align:center;">
    <div style="font-size:48px; line-height:1;"><%= happy ? "🎉" : "🙏" %></div>
    <div style="color:var(--primary-2,#E08A3C); font-size:26px; letter-spacing:3px; margin-top:8px;">
      <%= "★" * @rating.stars %><span style="opacity:.3;"><%= "★" * (5 - @rating.stars) %></span>
    </div>
    <h2 class="l-display" style="font-size:21px; margin-top:12px;">
      <%= happy ? t("customer.review_thanks.happy_title") : t("customer.review_thanks.sorry_title") %>
    </h2>
    <p style="color:var(--ink-2); font-size:14px; margin-top:8px;">
      <%= happy ? t("customer.review_thanks.happy_body", shop: current_workspace.name)
                : t("customer.review_thanks.sorry_body", shop: current_workspace.name) %>
    </p>

    <%# Khách hài lòng → mời đăng công khai lên Google. Kênh kéo khách mới rẻ nhất. %>
    <% if happy && google.present? %>
      <div style="margin-top:18px; padding:14px; border-radius:14px; background:var(--surface-2); text-align:left;">
        <div style="font-weight:700; font-size:15px;"><%= t("customer.review_thanks.google_title") %></div>
        <p style="color:var(--ink-2); font-size:13px; margin-top:4px;"><%= t("customer.review_thanks.google_body") %></p>
        <%= link_to t("customer.review_thanks.google_cta"), google,
              target: "_blank", rel: "noopener nofollow",
              class: "l-btn l-btn-primary l-btn-block", style: "margin-top:12px;" %>
      </div>
    <% end %>

    <%# Khách chấm thấp mà quán có bật "xin lỗi tự động" → quà đã vào ví %>
    <% if @apology %>
      <div style="margin-top:18px; padding:14px; border-radius:14px; background:var(--surface-2); text-align:left;">
        <div style="font-weight:700; font-size:15px;">🎁 <%= t("customer.review_thanks.apology_title") %></div>
        <p style="color:var(--ink-2); font-size:13px; margin-top:4px;">
          <%= t("customer.review_thanks.apology_body", title: @apology.reward&.title) %>
        </p>
        <%= link_to t("customer.review_thanks.apology_cta"), member_voucher_path(@apology),
              class: "l-btn l-btn-primary l-btn-block", style: "margin-top:12px;" %>
      </div>
    <% end %>

    <%= link_to t("customer.common.home_back"), member_root_path,
          class: "l-btn l-btn-ghost l-btn-block", style: "margin-top:14px;" %>
  </div>
</div>
