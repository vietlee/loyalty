<% content_for :title, "Đánh giá quán" %>
<% content_for :tab, "" %>
<header class="l-appbar" style="padding-left:0;">
  <%= link_to "←", member_profile_path, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:22px;">Đánh giá quán</div>
</header>

<div class="l-screen">
  <div class="l-tile" data-controller="rating">
    <div style="font-weight:700; margin-bottom:6px;"><%= current_workspace.name %></div>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:16px;">Chia sẻ trải nghiệm của bạn — đánh giá của bạn sẽ hiển thị công khai để giúp khách khác.</p>

    <%= form_with url: member_review_path, method: :post do %>
      <input type="hidden" name="stars" value="<%= @rating.stars || 5 %>" data-rating-target="input">
      <div style="display:flex; gap:8px; justify-content:center; font-size:40px; margin:6px 0 18px; cursor:pointer;">
        <% (1..5).each do |i| %>
          <span data-rating-target="star" data-value="<%= i %>" data-action="click->rating#set" style="user-select:none; color:var(--primary-2,#E08A3C);">★</span>
        <% end %>
      </div>

      <label class="l-label">Nhận xét (không bắt buộc)</label>
      <%= text_area_tag :comment, @rating.comment, class: "l-field", rows: 4, placeholder: "Đồ uống ngon, phục vụ thân thiện…" %>

      <%= submit_tag (@rating.persisted? ? "Cập nhật đánh giá" : "Gửi đánh giá"), class: "l-btn l-btn-primary l-btn-block", style: "margin-top:16px;" %>
    <% end %>
  </div>
</div>
