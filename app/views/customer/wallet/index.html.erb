<% content_for :title, "Ví thưởng" %>
<% content_for :tab, "wallet" %>
<header class="l-appbar">
  <div class="nm l-display" style="font-size:22px;">Ví thưởng</div>
  <span class="l-chip l-chip-brand" style="margin-left:auto;"><%= number_with_delimiter(@member.points_balance) %> điểm</span>
</header>

<div class="l-screen" data-controller="tabs" data-tabs-active-value="rewards">
  <div class="l-wtabs">
    <button data-tabs-target="tab" data-name="rewards" data-action="tabs#select">Có thể đổi</button>
    <button data-tabs-target="tab" data-name="owned"   data-action="tabs#select">Đã đổi</button>
    <button data-tabs-target="tab" data-name="expiring" data-action="tabs#select">Sắp hết hạn</button>
  </div>

  <%# ---- Có thể đổi (catalog) ---- %>
  <div data-tabs-target="panel" data-name="rewards">
    <% if @rewards.empty? %>
      <%= render "customer/wallet/empty", icon: "🎁", text: "Chưa có ưu đãi để đổi" %>
    <% else %>
      <% @rewards.each do |r| %>
        <%= link_to member_reward_path(r), class: "l-ticket", style: "margin-bottom:12px;" do %>
          <div class="stub"><div class="v"><%= r.value_label %></div><div class="u"><%= r.kind %></div></div>
          <div class="perf"></div>
          <div class="body">
            <div style="font-weight:700;"><%= r.display_icon %> <%= r.title %></div>
            <div style="font-size:12px; color:var(--ink-2); margin:4px 0;"><%= truncate(r.description.to_s, length: 60) %></div>
            <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
              <span class="l-chip l-chip-brand"><%= number_with_delimiter(r.cost_points) %> điểm</span>
              <% if r.remaining %><span class="l-chip">Còn <%= r.remaining %></span><% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%# ---- Đã đổi (owned vouchers) ---- %>
  <div data-tabs-target="panel" data-name="owned" hidden>
    <% if @vouchers.empty? %>
      <%= render "customer/wallet/empty", icon: "🎟️", text: "Bạn chưa đổi ưu đãi nào" %>
    <% else %>
      <% @vouchers.each do |v| %><%= render "customer/wallet/voucher", v: v %><% end %>
    <% end %>
  </div>

  <%# ---- Sắp hết hạn ---- %>
  <div data-tabs-target="panel" data-name="expiring" hidden>
    <% if @expiring.empty? %>
      <%= render "customer/wallet/empty", icon: "⏳", text: "Không có ưu đãi sắp hết hạn" %>
    <% else %>
      <% @expiring.each do |v| %><%= render "customer/wallet/voucher", v: v %><% end %>
    <% end %>
  </div>
</div>
