<% content_for :title, "Nhiệm vụ" %>
<% content_for :tab, "" %>
<header class="l-appbar">
  <%= link_to "←", member_root_path, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:22px;">Nhiệm vụ</div>
</header>

<div class="l-screen">
  <% %w[daily weekly].each do |period| %>
    <% list = @missions.select { |m| m.period == period } %>
    <% next if list.empty? %>
    <div class="l-section-h"><h3><%= period == "daily" ? "Hôm nay" : "Tuần này" %></h3></div>
    <div class="l-tile">
      <% list.each do |m| %>
        <% mp = @progress[m] %>
        <div class="l-mission">
          <div class="ic"><%= m.display_icon %></div>
          <div style="flex:1; min-width:0;">
            <div style="font-weight:600;"><%= m.title %></div>
            <div class="l-bar"><span style="width:<%= mp.pct %>%;"></span></div>
            <div style="font-size:11px; color:var(--ink-2); margin-top:4px;">
              <% if m.mission_type == "spend" %><%= number_with_delimiter(mp.progress) %>/<%= number_with_delimiter(m.goal) %>đ<% else %><%= mp.progress %>/<%= m.goal %><% end %> · +<%= m.reward_points %> điểm
            </div>
          </div>
          <div>
            <% if mp.completed? %>
              <span class="l-chip" style="background:var(--good-soft,#DEEBE1); color:var(--good);">✓ Xong</span>
            <% elsif m.mission_type == "checkin" %>
              <%= button_to "Check-in", member_mission_checkin_path(m), method: :post, class: "l-btn l-btn-primary", style: "padding:8px 14px; font-size:13px;" %>
            <% else %>
              <span class="l-chip">Đang làm</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
