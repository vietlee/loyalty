<% content_for :title, t("customer.checkin.success_title") %>
<% content_for :tab, "" %>
<div class="l-screen" data-controller="pointburst sfx" style="display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:80vh; text-align:center;">
  <div style="width:84px; height:84px; border-radius:50%; background:var(--good); color:#fff; display:grid; place-items:center; font-size:42px;">📍</div>
  <h2 class="l-display" style="font-size:24px; margin-top:14px;"><%= t("customer.checkin.success_heading") %></h2>
  <% if @points.to_i.positive? %>
    <div class="l-num" style="font-size:56px; color:var(--primary-ink);">+<%= number_with_delimiter(@points) %></div>
    <p style="color:var(--ink-2);"><%= t("customer.checkin.success_points", n: number_with_delimiter(current_member.points_balance)) %></p>
  <% else %>
    <p style="color:var(--ink-2); margin-top:8px;"><%= t("customer.checkin.success_recorded") %></p>
  <% end %>
  <%= link_to t("customer.common.home_back"), member_root_path, class: "l-btn l-btn-primary l-btn-block", style: "margin-top:20px; max-width:360px;" %>
</div>
