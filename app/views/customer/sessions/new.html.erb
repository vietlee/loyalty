<% content_for :title, t("customer.session.login_title", name: current_workspace.name) %>
<div class="l-screen" style="display:flex; flex-direction:column; justify-content:center; min-height:100dvh;">
  <div style="text-align:center; margin-bottom:26px;">
    <% if current_workspace.logo.attached? %>
      <div style="width:72px; height:72px; border-radius:22px; margin:0 auto 16px; overflow:hidden;">
        <%= image_tag url_for(current_workspace.logo), style: "width:100%;height:100%;object-fit:cover;" %>
      </div>
    <% else %>
      <div style="width:72px; height:72px; border-radius:22px; margin:0 auto 16px; background:var(--primary); color:var(--on-primary); display:grid; place-items:center; font-family:var(--font-display); font-weight:700; font-size:30px;">
        <%= current_workspace.logo_initials %>
      </div>
    <% end %>
    <h1 class="l-display" style="font-size:26px;"><%= current_workspace.name %></h1>
    <p style="color:var(--ink-2); font-size:14px;"><%= current_workspace.branding_value("tagline") %></p>
  </div>

  <%= form_with url: member_login_path, method: :post do %>
    <label class="l-label"><%= t("customer.session.phone_label") %></label>
    <input type="email" name="email" value="<%= @email %>" autocomplete="email" autofocus
           class="l-field" placeholder="you@example.com" style="margin-bottom:16px;">
    <%= submit_tag t("customer.session.get_otp"), class: "l-btn l-btn-primary l-btn-block" %>
  <% end %>

  <p style="text-align:center; color:var(--ink-2); font-size:12px; margin-top:18px;">
    <%= t("customer.session.login_footer") %>
  </p>
</div>
