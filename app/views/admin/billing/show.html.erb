<% content_for :title, "Gói & Billing" %>

<div class="l-kpis">
  <div class="l-kpi"><div class="k">MRR ước tính</div><div class="v"><%= number_with_delimiter(@mrr) %>đ</div><div class="d">doanh thu/tháng</div></div>
  <div class="l-kpi"><div class="k">Đang trả phí</div><div class="v"><%= @active %></div></div>
  <div class="l-kpi"><div class="k">Dùng thử</div><div class="v"><%= @trial %></div></div>
  <div class="l-kpi"><div class="k">Quá hạn</div><div class="v" style="color:var(--warn);"><%= @past_due.size %></div></div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:20px;">
  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Doanh thu theo gói</h3>
    <% Workspace::PLAN_PRICES.each do |plan, price| %>
      <% count = @by_plan[plan] || 0 %>
      <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 0; border-top:1px solid var(--line);">
        <div><strong style="text-transform:capitalize;"><%= plan %></strong> <span style="color:var(--ink-2); font-size:13px;">(<%= number_with_delimiter(price) %>đ)</span></div>
        <div><%= count %> ws · <strong><%= number_with_delimiter(price * count) %>đ</strong></div>
      </div>
    <% end %>
  </div>
  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Cần theo dõi (quá hạn)</h3>
    <% if @past_due.empty? %>
      <p style="color:var(--ink-2);">Không có workspace quá hạn 🎉</p>
    <% else %>
      <% @past_due.each do |ws| %>
        <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-top:1px solid var(--line);">
          <strong><%= ws.name %></strong>
          <%= link_to "Xử lý", admin_workspace_path(ws), class: "l-btn l-btn-ghost", style: "margin-left:auto; padding:4px 10px; font-size:12px;" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
