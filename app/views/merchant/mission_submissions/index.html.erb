<% content_for :title, t("merchant.gami.rq_title") %>
<% content_for :title_en, "PROOF REVIEW" %>
<% g = ->(k, **o) { t("merchant.gami.#{k}", **o) } %>
<% merchant_back merchant_gamification_path %>

<%= form_with url: merchant_mission_submissions_path, method: :get, data: { turbo: false } do %>
  <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
    <% [["pending", g.(:rq_pending)], ["approved", g.(:rq_approved)], ["rejected", g.(:rq_rejected)]].each do |val, lbl| %>
      <button type="submit" name="status" value="<%= val %>"
              class="l-chip <%= 'l-chip-brand' if @status == val %>" style="border:none; cursor:pointer;">
        <%= lbl %><%= " · #{@pending_count}" if val == "pending" && @pending_count.positive? %>
      </button>
    <% end %>
  </div>
<% end %>

<% if @submissions.empty? %>
  <div class="l-panel" style="text-align:center; padding:40px; color:var(--ink-2);">
    <div style="font-size:40px;">📭</div>
    <p style="margin-top:8px;"><%= g.(:rq_empty) %></p>
  </div>
<% else %>
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px;">
    <% @submissions.each do |s| %>
      <div class="l-panel" style="padding:14px;">
        <div style="display:flex; gap:10px; align-items:center; margin-bottom:10px;">
          <span style="font-size:22px;"><%= s.mission.display_icon %></span>
          <div style="flex:1; min-width:0;">
            <div style="font-weight:700;"><%= s.member.display_name %></div>
            <div style="font-size:12px; color:var(--ink-2);"><%= s.mission.title %></div>
          </div>
          <% if s.platform.present? %>
            <span class="l-chip" style="font-size:11px;"><%= Mission::PLATFORM_LABELS[s.platform] || s.platform %></span>
          <% end %>
        </div>

        <% if s.photo.attached? %>
          <a href="<%= url_for(s.photo) %>" target="_blank" rel="noopener">
            <%= image_tag s.photo.variant(resize_to_limit: [600, 600]),
                  style: "width:100%; border-radius:12px; display:block;" %>
          </a>
        <% end %>

        <% if s.note.present? %>
          <p style="font-size:13px; color:var(--ink-2); margin-top:8px;"><%= s.note %></p>
        <% end %>

        <% if s.ai_verdict.present? && s.ai_verdict["reason"].present? %>
          <div class="l-chip" style="margin-top:8px; font-size:11px; white-space:normal; height:auto; padding:6px 10px;">
            🤖 <%= g.(:rq_ai) %>: <%= s.ai_verdict["reason"] %>
            <% if s.ai_verdict["confidence"] %>(<%= (s.ai_verdict["confidence"].to_f * 100).round %>%)<% end %>
          </div>
        <% end %>

        <div style="font-size:11px; color:var(--ink-2); margin-top:8px;">
          <%= g.(:rq_submitted) %>: <%= s.submitted_at ? l(s.submitted_at, format: :short) : "—" %>
        </div>

        <% if s.pending? %>
          <div style="display:flex; gap:8px; margin-top:12px;">
            <%= button_to g.(:rq_approve), approve_merchant_mission_submission_path(s), method: :patch,
                  class: "l-btn l-btn-primary", style: "flex:1; padding:8px; font-size:13px;" %>
            <%= button_to g.(:rq_reject), reject_merchant_mission_submission_path(s), method: :patch,
                  class: "l-btn l-btn-ghost", style: "flex:1; padding:8px; font-size:13px; color:var(--warn);",
                  form: { data: { turbo_confirm: g.(:rq_reject_prompt) } } %>
          </div>
        <% elsif s.approved? %>
          <div class="l-chip" style="margin-top:12px; background:var(--good-soft,#DEEBE1); color:var(--good);">✓ <%= g.(:rq_approved) %></div>
        <% else %>
          <div class="l-chip" style="margin-top:12px; color:var(--warn);">✕ <%= g.(:rq_rejected) %></div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
