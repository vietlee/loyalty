<% content_for :title, "Gói dịch vụ" %>
<% content_for :title_en, "BILLING" %>

<div style="max-width:820px;">
  <div class="l-panel" style="display:flex; align-items:center; gap:16px; margin-bottom:16px;">
    <div style="flex:1;">
      <div class="l-eyebrow">Gói hiện tại</div>
      <div class="l-display" style="font-size:26px;"><%= @plan.name %></div>
      <div style="color:var(--ink-2); font-size:14px;"><%= @workspace.status_label %> · <%= number_with_delimiter(@members) %> khách<%= " / #{@plan.max_members}" if @plan.max_members %></div>
    </div>
    <div style="text-align:right;">
      <div class="l-num" style="font-size:30px;"><%= @plan.price_label %></div>
      <div style="color:var(--ink-2); font-size:13px;">/tháng</div>
    </div>
  </div>

  <%# ---- Subscription status + pay ---- %>
  <div class="l-panel" style="display:flex; align-items:center; gap:16px; margin-bottom:20px;">
    <div style="flex:1;">
      <div class="l-eyebrow">Trạng thái thuê bao</div>
      <% if @workspace.subscription_active? %>
        <div style="font-weight:700; color:var(--good); margin-top:4px;">✓ Đang hiệu lực</div>
        <div style="color:var(--ink-2); font-size:13px;">Đã thanh toán đến <%= l(@workspace.paid_until.to_date, format: :long) %> (còn <%= @workspace.subscription_days_left %> ngày)</div>
      <% else %>
        <div style="font-weight:700; color:var(--warn); margin-top:4px;">● Chưa thanh toán</div>
        <div style="color:var(--ink-2); font-size:13px;">Thanh toán để kích hoạt đầy đủ dịch vụ.</div>
      <% end %>
    </div>
    <% if @payos_ready %>
      <div style="text-align:right;">
        <%= button_to merchant_billing_pay_path, method: :post, class: "l-btn l-btn-primary",
              style: "white-space:nowrap;", form: { data: { turbo: false } } do %>
          Thanh toán <%= @plan.price_label %> · qua PayOS
        <% end %>
        <%= form_with url: merchant_billing_auto_renew_path, method: :patch, style: "margin-top:8px;" do %>
          <input type="hidden" name="auto_renew" value="<%= @workspace.auto_renew ? '0' : '1' %>">
          <label style="display:flex; align-items:center; gap:6px; justify-content:flex-end; font-size:12px; color:var(--ink-2); cursor:pointer;">
            <span class="l-switch" style="pointer-events:none;"><input type="checkbox" <%= 'checked' if @workspace.auto_renew %> disabled><span class="knob"></span></span>
            Tự động tạo hoá đơn hàng tháng
          </label>
          <%= submit_tag @workspace.auto_renew ? "Tắt tự động" : "Bật tự động", class: "l-mono", style: "background:none;border:none;color:var(--primary-ink);font-size:11px;cursor:pointer;padding:0;" %>
        <% end %>
      </div>
    <% else %>
      <span class="l-chip">PayOS chưa cấu hình</span>
    <% end %>
  </div>

  <% if @invoices.any? %>
    <div class="l-panel" style="margin-bottom:20px;">
      <div class="l-eyebrow" style="margin-bottom:8px;">Lịch sử hoá đơn</div>
      <table style="width:100%; border-collapse:collapse; font-size:13px;">
        <% @invoices.each do |inv| %>
          <tr style="border-top:1px solid var(--line);">
            <td style="padding:8px 4px;"><%= inv.period_label %></td>
            <td><%= inv.plan %></td>
            <td style="text-align:right; font-weight:600;"><%= number_with_delimiter(inv.amount) %>đ</td>
            <td style="text-align:right;">
              <% color = { "paid" => "var(--good)", "pending" => "var(--primary)", "failed" => "var(--warn)", "cancelled" => "var(--ink-2)" }[inv.status] %>
              <span class="l-chip" style="background:<%= color %>22; color:<%= color %>;"><%= { "paid"=>"Đã trả","pending"=>"Chờ","failed"=>"Lỗi","cancelled"=>"Huỷ" }[inv.status] %></span>
              <% if inv.pending? && inv.checkout_url %><%= link_to "Trả tiếp", inv.checkout_url, class: "l-chip l-chip-brand" %><% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  <% end %>

  <div class="l-eyebrow" style="margin-bottom:10px;">Các gói</div>
  <div style="display:grid; grid-template-columns:repeat(<%= @plans.size %>,1fr); gap:14px;">
    <% @plans.each do |plan| %>
      <% current = @workspace.plan == plan.key %>
      <div class="l-panel" style="<%= 'border:2px solid var(--primary);' if current %>">
        <div style="font-weight:700; font-size:16px;"><%= plan.name %></div>
        <div class="l-num" style="font-size:24px; margin:6px 0;"><%= plan.price_label %></div>
        <ul style="list-style:none; font-size:13px; color:var(--ink-2); display:flex; flex-direction:column; gap:6px; margin:10px 0;">
          <% plan.features.each do |feat| %><li>✓ <%= feat %></li><% end %>
        </ul>
        <% if current %>
          <span class="l-chip l-chip-brand" style="width:100%; justify-content:center;">Đang dùng</span>
        <% else %>
          <button class="l-btn l-btn-soft l-btn-block" disabled>Liên hệ nâng cấp</button>
        <% end %>
      </div>
    <% end %>
  </div>
  <p style="font-size:12px; color:var(--ink-2); margin-top:14px;">Đổi gói do quản trị nền tảng thực hiện. (Cổng thanh toán tích hợp ở bản production.)</p>
</div>
