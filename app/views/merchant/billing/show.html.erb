<% content_for :title, "Gói dịch vụ" %>
<% content_for :title_en, "BILLING" %>

<div style="max-width:760px;">
  <div class="l-panel" style="display:flex; align-items:center; gap:16px; margin-bottom:20px;">
    <div style="flex:1;">
      <div class="l-eyebrow">Gói hiện tại</div>
      <div class="l-display" style="font-size:26px; text-transform:capitalize;"><%= @workspace.plan %></div>
      <div style="color:var(--ink-2); font-size:14px;"><%= @workspace.status_label %> · <%= number_with_delimiter(@members) %> khách hàng</div>
    </div>
    <div style="text-align:right;">
      <div class="l-num" style="font-size:30px;"><%= number_with_delimiter(@price) %>đ</div>
      <div style="color:var(--ink-2); font-size:13px;">/tháng</div>
    </div>
  </div>

  <div class="l-eyebrow" style="margin-bottom:10px;">Các gói</div>
  <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:14px;">
    <% plan_feats = { "starter" => ["1 chi nhánh", "Points + Stamp", "500 khách"], "growth" => ["5 chi nhánh", "Đủ 4 cơ chế", "Không giới hạn khách", "Campaign + QR"], "scale" => ["Không giới hạn chi nhánh", "Tên miền riêng", "A/B testing", "Ưu tiên hỗ trợ"] } %>
    <% @plans.each do |plan, price| %>
      <% current = @workspace.plan == plan %>
      <div class="l-panel" style="<%= 'border:2px solid var(--primary);' if current %>">
        <div style="font-weight:700; text-transform:capitalize; font-size:16px;"><%= plan %></div>
        <div class="l-num" style="font-size:24px; margin:6px 0;"><%= number_with_delimiter(price) %>đ</div>
        <ul style="list-style:none; font-size:13px; color:var(--ink-2); display:flex; flex-direction:column; gap:6px; margin:10px 0;">
          <% plan_feats[plan].each do |feat| %><li>✓ <%= feat %></li><% end %>
        </ul>
        <% if current %>
          <span class="l-chip l-chip-brand" style="width:100%; justify-content:center;">Đang dùng</span>
        <% else %>
          <button class="l-btn l-btn-soft l-btn-block" disabled>Liên hệ nâng cấp</button>
        <% end %>
      </div>
    <% end %>
  </div>
  <p style="font-size:12px; color:var(--ink-2); margin-top:14px;">Thanh toán qua nền tảng — liên hệ để đổi gói. (Cổng thanh toán tích hợp ở bản production.)</p>
</div>
