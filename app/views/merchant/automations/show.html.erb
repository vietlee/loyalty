<% content_for :title, t("merchant.nav.automations") %>
<% content_for :title_en, "AUTOMATIONS" %>
<% reward_opts = @rewards.map { |r| [r.title, r.id] } %>

<div style="max-width:680px;">
  <p style="color:var(--ink-2); font-size:14px; margin-bottom:16px;"><%= t("merchant.automations.intro") %></p>

  <% if @rewards.empty? %>
    <div class="l-panel" style="background:#F7E0DA; color:#B4402F;"><%= t("merchant.automations.need_reward") %></div>
  <% end %>

  <%= form_with url: merchant_automations_path, method: :patch do %>
    <% %w[welcome birthday winback].each do |kind| %>
      <% title = t("merchant.automations.#{kind}_title"); desc = t("merchant.automations.#{kind}_desc") %>
      <% c = @cfg[kind] || {} %>
      <div class="l-panel" style="margin-bottom:14px;">
        <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
          <input type="hidden" name="automations[<%= kind %>][enabled]" value="0">
          <input type="checkbox" name="automations[<%= kind %>][enabled]" value="1" <%= "checked" if c["enabled"] %> style="width:18px;height:18px; accent-color:var(--primary);">
          <span style="font-weight:700; font-size:16px;"><%= title %></span>
        </label>
        <p style="color:var(--ink-2); font-size:13px; margin:6px 0 12px 28px;"><%= desc %></p>

        <div style="margin-left:28px; display:grid; gap:10px;">
          <div>
            <label class="l-label"><%= kind == "winback" ? t("merchant.automations.gift_optional") : t("merchant.automations.gift") %></label>
            <%= select_tag "automations[#{kind}][reward_id]", options_for_select(reward_opts, c["reward_id"].to_i),
                  include_blank: (kind == "winback" ? t("merchant.automations.no_gift") : t("merchant.automations.pick_reward")), class: "l-field" %>
          </div>

          <% if kind == "winback" %>
            <div style="display:grid; grid-template-columns:150px 1fr; gap:10px;">
              <div>
                <label class="l-label"><%= t("merchant.automations.winback_days") %></label>
                <%= number_field_tag "automations[winback][days]", (c["days"].presence || 30), class: "l-field", min: 1 %>
              </div>
              <div>
                <label class="l-label"><%= t("merchant.automations.message") %></label>
                <%= text_field_tag "automations[winback][message]", c["message"], class: "l-field", placeholder: t("merchant.automations.message_ph") %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= submit_tag t("merchant.automations.save"), class: "l-btn l-btn-primary", style: "margin-top:4px;" %>
  <% end %>
</div>
