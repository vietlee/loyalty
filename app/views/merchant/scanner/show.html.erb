<% content_for :title, t("merchant.nav.scanner") %>
<% content_for :title_en, "COUNTER SCANNER" %>

<% kiosk = local_assigns.fetch(:kiosk, false) || @kiosk %>
<% kiosk_param = kiosk ? { kiosk: 1 } : {} %>
<div style="max-width:560px; margin:0 auto;">
  <% if selectable_outlets.size > 1 %>
    <%= form_with url: merchant_scanner_path, method: :get, data: { turbo: false } do %>
      <% if kiosk %><input type="hidden" name="kiosk" value="1"><% end %>
      <input type="hidden" name="tab" value="<%= @tab %>">
      <label class="l-label"><%= t("merchant.scan.selling_branch") %></label>
      <select name="outlet" class="l-field" style="margin-bottom:16px;" onchange="this.form.requestSubmit()">
        <% selectable_outlets.each do |o| %>
          <option value="<%= o.id %>" <%= "selected" if current_outlet&.id == o.id %>><%= o.name %></option>
        <% end %>
      </select>
    <% end %>
  <% elsif current_outlet %>
    <div style="margin-bottom:14px; font-size:13px; color:var(--ink-2);"><%= t("merchant.scan.branch_prefix") %>: <strong style="color:var(--ink);"><%= current_outlet.name %></strong></div>
  <% end %>

  <div style="display:flex; gap:8px; margin-bottom:16px;">
    <%= link_to t("merchant.scan.tab_earn"), merchant_scanner_path(kiosk_param.merge(tab: "earn")),
          class: "l-chip #{'l-chip-brand' if @tab == 'earn'}", data: { turbo_frame: "scan_tool" } %>
    <%= link_to t("merchant.scan.tab_redeem"), merchant_scanner_path(kiosk_param.merge(tab: "redeem")),
          class: "l-chip #{'l-chip-brand' if @tab == 'redeem'}", data: { turbo_frame: "scan_tool" } %>
    <% if current_program.scan_member? %>
      <%= link_to t("merchant.scan.tab_pos"), merchant_scanner_path(kiosk_param.merge(tab: "pos")),
            class: "l-chip #{'l-chip-brand' if @tab == 'pos'}", data: { turbo_frame: "scan_tool" } %>
    <% end %>
    <%= link_to t("merchant.scan.tab_checkin"), merchant_scanner_path(kiosk_param.merge(tab: "checkin")),
          class: "l-chip #{'l-chip-brand' if @tab == 'checkin'}", data: { turbo_frame: "scan_tool" } %>
  </div>

  <div class="l-panel">
    <%= turbo_frame_tag "scan_tool" do %>
      <% if @tab == "checkin" %>
        <%= render "checkin_qr", kiosk_param: kiosk_param %>
      <% else %>
        <%= render "merchant/#{@tab}/search" %>
      <% end %>
    <% end %>
  </div>
</div>
