<%= form_with model: reward, url: url, method: method, data: { controller: "rewardform",
      rewardform_vnd_label_value: t("merchant.reward_units.vnd_label"),
      rewardform_percent_label_value: t("merchant.reward_units.percent_label"),
      rewardform_item_label_value: t("merchant.reward_units.item_label"),
      rewardform_vnd_ph_value: t("merchant.reward_units.vnd_ph"),
      rewardform_percent_ph_value: t("merchant.reward_units.percent_ph"),
      rewardform_item_ph_value: t("merchant.reward_units.item_ph") } do |f| %>
  <% if reward.errors.any? %>
    <div class="l-chip" style="background:#F3DDD7; color:#B4402F; margin-bottom:12px;"><%= reward.errors.full_messages.to_sentence %></div>
  <% end %>
  <label class="l-label"><%= t("merchant.rewards.name") %></label>
  <%= f.text_field :title, class: "l-field", placeholder: t("merchant.rewards.name_ph") %>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
    <div>
      <label class="l-label"><%= t("merchant.rewards.kind") %></label>
      <%= f.select :kind, [["Voucher", "voucher"], [t("merchant.rewards.kind_gift"), "gift"], [t("merchant.rewards.kind_discount"), "discount"]], {},
            class: "l-field", data: { rewardform_target: "kind", action: "change->rewardform#kindChanged" } %>
    </div>
    <div data-controller="iconpick">
      <label class="l-label"><%= t("merchant.rewards.icon") %></label>
      <%= f.text_field :icon, class: "l-field", placeholder: "🎁", data: { iconpick_target: "input" } %>
      <div class="l-iconpick">
        <% %w[🎁 ☕ 🧋 🍰 🥐 🍩 🍔 🍜 🥤 🍺 🎟️ 🏷️ 🛍️ 👜 ✨ 💆 ⭐ 🔥 🎉 💎].each do |e| %>
          <button type="button" class="l-iconpick-btn" data-action="iconpick#pick" data-emoji="<%= e %>"><%= e %></button>
        <% end %>
      </div>
    </div>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-top:12px;">
    <div>
      <label class="l-label"><%= t("merchant.rewards.cost") %></label>
      <%= f.number_field :cost_points, class: "l-field", placeholder: "300" %>
    </div>
    <div>
      <label class="l-label" data-rewardform-target="valueLabel"><%= t("merchant.rewards.value") %></label>
      <%= f.number_field :value, class: "l-field", min: 0, step: "any", placeholder: "30",
            data: { rewardform_target: "value" } %>
    </div>
    <div>
      <label class="l-label"><%= t("merchant.rewards.unit") %></label>
      <%= f.select :value_unit, [["đ", "vnd"], ["%", "percent"], [t("merchant.rewards.unit_item"), "item"]], {},
            class: "l-field", data: { rewardform_target: "unit", action: "change->rewardform#syncLabel" } %>
    </div>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
    <div>
      <label class="l-label"><%= t("merchant.rewards.stock") %></label>
      <%= f.number_field :stock, class: "l-field", placeholder: "∞" %>
    </div>
    <div>
      <label class="l-label"><%= t("merchant.rewards.valid_days") %></label>
      <%= f.number_field :valid_days, class: "l-field" %>
    </div>
  </div>

  <%# ---- Availability schedule ---- %>
  <div style="margin-top:14px; padding:12px 14px; border:1px solid var(--line); border-radius:12px;">
    <div class="l-eyebrow" style="margin-bottom:8px;"><%= t("merchant.rewards.sched_title") %></div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
      <div>
        <label class="l-label"><%= t("merchant.rewards.sched_from") %></label>
        <%= f.datetime_local_field :starts_at, value: f.object.starts_at&.strftime("%Y-%m-%dT%H:%M"), class: "l-field" %>
      </div>
      <div>
        <label class="l-label"><%= t("merchant.rewards.sched_to") %></label>
        <%= f.datetime_local_field :ends_at, value: f.object.ends_at&.strftime("%Y-%m-%dT%H:%M"), class: "l-field" %>
      </div>
    </div>
    <% sch = f.object.schedule || {} %>
    <label class="l-label" style="margin-top:12px;"><%= t("merchant.rewards.sched_days") %></label>
    <div style="display:flex; flex-wrap:wrap; gap:6px;">
      <% Reward::WDAYS_VI.each_with_index do |lbl, wd| %>
        <label class="l-daychip">
          <%= check_box_tag "reward[schedule][days][]", wd, Array(sch["days"]).map(&:to_i).include?(wd), style: "display:none;" %>
          <span><%= lbl %></span>
        </label>
      <% end %>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
      <div>
        <label class="l-label"><%= t("merchant.rewards.sched_from_hour") %></label>
        <%= select_tag "reward[schedule][from_hour]", options_for_select((0..23).map { |h| ["#{format('%02d',h)}:00", h] }, sch["from_hour"]), include_blank: "—", class: "l-field" %>
      </div>
      <div>
        <label class="l-label"><%= t("merchant.rewards.sched_to_hour") %></label>
        <%= select_tag "reward[schedule][to_hour]", options_for_select((0..23).map { |h| ["#{format('%02d',h)}:59", h] }, sch["to_hour"]), include_blank: "—", class: "l-field" %>
      </div>
    </div>
    <p style="color:var(--ink-2); font-size:12px; margin-top:8px;"><%= t("merchant.rewards.sched_hint") %></p>
  </div>

  <label class="l-label" style="margin-top:12px;"><%= t("merchant.rewards.description") %></label>
  <%= f.text_area :description, class: "l-field", rows: 2, placeholder: t("merchant.rewards.description_ph") %>

  <label style="display:flex; align-items:center; gap:8px; margin-top:12px; font-size:14px;">
    <%= f.check_box :active %> <%= t("merchant.rewards.active") %>
  </label>

  <%= f.submit submit_label, class: "l-btn l-btn-primary", style: "margin-top:14px;" %>
<% end %>
