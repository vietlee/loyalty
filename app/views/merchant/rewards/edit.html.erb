<% content_for :title, t("merchant.rewards.edit_title") %>
<% content_for :title_en, "EDIT REWARD" %>
<div class="l-panel" style="max-width:520px;">
  <%= render "form", reward: @reward, url: merchant_reward_path(@reward), method: :patch, submit_label: t("merchant.rewards.save") %>
  <%= link_to t("merchant.rewards.back"), merchant_rewards_path, style: "display:inline-block; margin-top:12px; color:var(--ink-2); font-size:13px;" %>
</div>
