<% content_for :title, "Đăng ký cửa hàng" %>
<h1>Tạo cửa hàng của bạn</h1>
<p class="sub">Mỗi cửa hàng có một app tri ân riêng — subdomain thương hiệu riêng.</p>

<% if @workspace.errors.any? %>
  <div class="l-chip" style="background:#F3DDD7; color:#B4402F; margin-bottom:14px; display:block; padding:10px 14px;">
    <%= @workspace.errors.full_messages.to_sentence %>
  </div>
<% end %>

<%= form_with model: @workspace, url: merchant_signup_path, method: :post do |f| %>
  <div class="field">
    <%= f.label :name, "Tên cửa hàng", class: "l-label" %>
    <%= f.text_field :name, class: "l-field", placeholder: "VD: Mộc Cà Phê" %>
  </div>

  <div class="field">
    <%= f.label :subdomain, "Địa chỉ app (subdomain)", class: "l-label" %>
    <div style="display:flex; align-items:center; gap:6px;">
      <%= f.text_field :subdomain, class: "l-field", placeholder: "moccaphe", style: "text-align:right;" %>
      <span class="l-mono" style="color:var(--ink-2); white-space:nowrap;">.loyalty.vn</span>
    </div>
    <div style="font-size:12px; color:var(--ink-2); margin-top:4px;">Khách của bạn sẽ mở app tại địa chỉ này.</div>
  </div>

  <div class="field">
    <%= f.label :industry, "Ngành", class: "l-label" %>
    <%= f.select :industry, [["F&B (cà phê, nhà hàng, trà sữa)", "fnb"], ["Bán lẻ (thời trang, mỹ phẩm)", "retail"], ["Dịch vụ (spa, salon, gym)", "service"]], {}, class: "l-field" %>
  </div>

  <hr style="border:none; border-top:1px solid var(--line); margin:16px 0;">

  <div class="field">
    <%= label_tag :owner_name, "Tên chủ cửa hàng", class: "l-label" %>
    <%= text_field_tag :owner_name, params[:owner_name], class: "l-field" %>
  </div>
  <div class="field">
    <%= label_tag :email, "Email đăng nhập", class: "l-label" %>
    <%= email_field_tag :email, params[:email], class: "l-field", placeholder: "you@example.com" %>
  </div>
  <div class="field">
    <%= label_tag :password, "Mật khẩu", class: "l-label" %>
    <%= password_field_tag :password, nil, class: "l-field", placeholder: "tối thiểu 6 ký tự" %>
  </div>

  <%= submit_tag "Tạo cửa hàng", class: "l-btn l-btn-primary l-btn-block" %>
<% end %>

<p style="text-align:center; color:var(--ink-2); font-size:13px; margin-top:16px;">
  Đã có tài khoản? <%= link_to "Đăng nhập", new_user_session_path, style: "color:var(--primary-ink); font-weight:600;" %>
</p>
