<% content_for :title, t("merchant.nav.feedback") %>
<% content_for :title_en, "FEEDBACK" %>
<% stars = ->(n) { "★" * n.round + "☆" * (5 - n.round) } %>

<div>
  <%# ---- Cài đặt trang đánh giá ---- %>
  <%= form_with url: merchant_feedback_path, method: :patch do %>
    <div class="l-panel">
      <h3 class="l-display" style="font-size:17px; margin-bottom:2px;"><%= t("merchant.feedback.settings_title") %></h3>
      <p style="color:var(--ink-2); font-size:13px; margin-bottom:14px;"><%= t("merchant.feedback.settings_note") %></p>

      <input type="hidden" name="feedback_public" value="0">
      <label style="display:flex; align-items:center; gap:10px; font-size:14px; cursor:pointer; padding:8px 0;">
        <input type="checkbox" name="feedback_public" value="1" <%= "checked" if current_workspace.feedback_public? %>
               style="width:18px;height:18px; accent-color:var(--primary);">
        <span>
          <strong><%= t("merchant.feedback.public_title") %></strong>
          <span style="display:block; color:var(--ink-2); font-size:12.5px;"><%= t("merchant.feedback.public_note") %></span>
        </span>
      </label>

      <div style="margin-top:14px;">
        <label class="l-label"><%= t("merchant.feedback.google_label") %></label>
        <%= text_field_tag :google_review_url, current_workspace.google_review_url,
              class: "l-field", placeholder: "https://g.page/r/…/review" %>
        <p style="color:var(--ink-2); font-size:12.5px; margin-top:5px;"><%= t("merchant.feedback.google_note") %></p>
      </div>

      <div style="margin-top:16px; padding-top:14px; border-top:1px solid var(--line);">
        <% low = current_workspace.automation(:low_rating) %>
        <input type="hidden" name="low_rating_enabled" value="0">
        <label style="display:flex; align-items:center; gap:10px; font-size:14px; cursor:pointer;">
          <input type="checkbox" name="low_rating_enabled" value="1" <%= "checked" if low["enabled"] %>
                 style="width:18px;height:18px; accent-color:var(--primary);">
          <span>
            <strong><%= t("merchant.feedback.apology_title") %></strong>
            <span style="display:block; color:var(--ink-2); font-size:12.5px;"><%= t("merchant.feedback.apology_note") %></span>
          </span>
        </label>
        <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;">
          <div style="flex:1; min-width:200px;">
            <label class="l-label"><%= t("merchant.feedback.apology_reward") %></label>
            <select name="low_rating_reward_id" class="l-field">
              <option value=""><%= t("merchant.feedback.apology_none") %></option>
              <% @rewards.each do |rw| %>
                <option value="<%= rw.id %>" <%= "selected" if low["reward_id"].to_s == rw.id.to_s %>><%= rw.title %></option>
              <% end %>
            </select>
          </div>
          <div style="width:160px;">
            <label class="l-label"><%= t("merchant.feedback.apology_threshold") %></label>
            <select name="low_rating_threshold" class="l-field">
              <% (1..4).each do |n| %>
                <option value="<%= n %>" <%= "selected" if (low["threshold"].presence || 3).to_i == n %>>≤ <%= n %> ★</option>
              <% end %>
            </select>
          </div>
        </div>
      </div>

      <%= submit_tag t("merchant.feedback.save"), class: "l-btn l-btn-primary", style: "margin-top:16px;" %>
    </div>
  <% end %>

  <%# ---- Summary ---- %>
  <div style="display:grid; grid-template-columns:200px 1fr; gap:16px; margin-top:16px; align-items:start;">
    <div class="l-panel" style="text-align:center;">
      <div class="l-num" style="font-size:44px; line-height:1;"><%= @avg %></div>
      <div style="color:var(--primary-2,#E08A3C); font-size:18px; letter-spacing:2px;"><%= stars.call(@avg) %></div>
      <div style="color:var(--ink-2); font-size:13px; margin-top:4px;"><%= t("merchant.feedback.reviews_count", n: @count) %></div>
    </div>
    <div class="l-panel">
      <% (5).downto(1) do |s| %>
        <% n = @dist[s] || 0; pct = @count.zero? ? 0 : (n.to_f / @count * 100).round %>
        <div style="display:flex; align-items:center; gap:10px; padding:4px 0;">
          <span style="width:34px; font-size:13px; color:var(--ink-2);"><%= s %> ★</span>
          <div style="flex:1; height:8px; border-radius:999px; background:var(--surface-2); overflow:hidden;"><span style="display:block; height:100%; width:<%= pct %>%; background:var(--primary-2,#E08A3C);"></span></div>
          <span style="width:30px; text-align:right; font-size:12px; color:var(--ink-2);"><%= n %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%# ---- All feedback ---- %>
  <div class="l-panel" style="margin-top:16px;">
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:12px;">
      <h3 class="l-display" style="font-size:17px; margin:0;"><%= t("merchant.feedback.all_reviews") %></h3>
      <div style="margin-left:auto; display:flex; gap:6px;">
        <% [[nil, t("merchant.feedback.filter_all")],
            ["unanswered", t("merchant.feedback.filter_unanswered")],
            ["low", t("merchant.feedback.filter_low")]].each do |key, label| %>
          <%= link_to label, merchant_feedback_path(filter: key),
                class: "l-btn #{@filter == key ? 'l-btn-primary' : 'l-btn-soft'}",
                style: "padding:5px 12px; font-size:12.5px;" %>
        <% end %>
      </div>
    </div>
    <% if @ratings.empty? %>
      <p style="color:var(--ink-2); font-size:13px;"><%= t("merchant.feedback.no_reviews") %></p>
    <% else %>
      <% @ratings.each do |r| %>
        <div style="padding:12px 0; border-bottom:1px solid var(--line);">
          <div style="display:flex; align-items:center; gap:10px;">
            <div style="font-weight:600;"><%= r.member&.display_name %></div>
            <div style="color:var(--primary-2,#E08A3C); font-size:13px; letter-spacing:1px;"><%= stars.call(r.stars) %></div>
            <div style="margin-left:auto; font-size:12px; color:var(--ink-2);"><%= l(r.created_at, format: :short) %></div>
          </div>
          <% if r.comment.present? %><div style="font-size:14px; margin-top:6px;"><%= r.comment %></div><% end %>

          <%# ---- Trả lời ---- %>
          <details style="margin-top:8px;" <%= "open" if r.replied? %>>
            <summary style="cursor:pointer; font-size:12.5px; color:var(--primary-ink); font-weight:600; list-style:none;">
              <%= r.replied? ? t("merchant.feedback.reply_edit") : t("merchant.feedback.reply_cta") %>
            </summary>
            <% if r.replied? %>
              <div style="font-size:12px; color:var(--ink-2); margin-top:6px;">
                <%= t("merchant.feedback.replied_by", name: r.replied_by&.name || current_workspace.name,
                      time: l(r.replied_at, format: :short)) %>
              </div>
            <% end %>
            <%= form_with url: merchant_reply_feedback_path(r), method: :patch do %>
              <%= text_area_tag :reply_body, r.reply_body, class: "l-field", rows: 2,
                    style: "margin-top:6px;", placeholder: t("merchant.feedback.reply_ph") %>
              <div style="display:flex; gap:8px; margin-top:8px;">
                <%= submit_tag t("merchant.feedback.reply_save"), class: "l-btn l-btn-primary",
                      style: "padding:6px 14px; font-size:13px;" %>
              </div>
            <% end %>
          </details>
        </div>
      <% end %>

      <%# ---- Pagination ---- %>
      <% if @page > 1 || @has_more %>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:14px; padding-top:12px; border-top:1px solid var(--line);">
          <% if @page > 1 %>
            <%= link_to t("merchant.pagination.prev"), merchant_feedback_path(request.query_parameters.merge(page: @page - 1)), class: "l-btn l-btn-soft" %>
          <% else %><span></span><% end %>
          <span style="font-size:13px; color:var(--ink-2);"><%= t("merchant.pagination.page", n: @page) %></span>
          <% if @has_more %>
            <%= link_to t("merchant.pagination.next"), merchant_feedback_path(request.query_parameters.merge(page: @page + 1)), class: "l-btn l-btn-soft" %>
          <% else %><span></span><% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
