<% content_for :title, t("merchant.broadcasts.sent_title") %>
<% content_for :title_en, "BROADCASTS" %>

<div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
  <%= link_to t("merchant.broadcasts.compose"), new_merchant_broadcast_path, class: "l-btn l-btn-primary" %>
</div>

<% if @broadcasts.empty? %>
  <div class="l-panel" style="text-align:center; padding:48px;">
    <div style="font-size:40px;">✉️</div>
    <h3 class="l-display" style="font-size:20px; margin-top:8px;"><%= t("merchant.broadcasts.empty") %></h3>
    <p style="color:var(--ink-2);"><%= t("merchant.broadcasts.empty_sub") %></p>
  </div>
<% else %>
  <div class="l-panel">
    <% @broadcasts.each do |b| %>
      <div style="display:flex; align-items:center; gap:12px; padding:12px 0; border-top:1px solid var(--line);">
        <span style="font-size:22px;"><%= MemberSegments.icon(b.segment_key) %></span>
        <div style="flex:1; min-width:0;">
          <div style="font-weight:700;"><%= b.title %></div>
          <div style="font-size:13px; color:var(--ink-2);"><%= truncate(b.body.to_s, length: 70) %></div>
        </div>
        <div style="text-align:right;">
          <% if b.scheduled? %><div class="l-chip" style="background:var(--surface-2);"><%= t("merchant.broadcasts.scheduled_chip", time: l(b.scheduled_at, format: :short)) %></div><% else %><div class="l-chip l-chip-brand"><%= t("merchant.broadcasts.count", n: b.sent_count) %></div><% end %>
          <div style="font-size:11px; color:var(--ink-2); margin-top:4px;"><%= b.audience_display %> · <%= l(b.created_at, format: :short) %></div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
