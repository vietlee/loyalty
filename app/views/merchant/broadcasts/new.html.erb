<% content_for :title, "Soạn thông báo" %>
<% content_for :title_en, "BROADCAST" %>

<div data-controller="campaign-preview" style="display:grid; grid-template-columns:1fr 360px; gap:20px; align-items:start;">
  <%= form_with model: @broadcast, url: merchant_broadcasts_path, method: :post do |f| %>
    <% if @broadcast.errors.any? %>
      <div class="l-panel" style="margin-bottom:16px; background:#F7E0DA; color:#B4402F; border:none;">
        <%= @broadcast.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div class="l-panel" style="margin-bottom:16px;">
      <div class="l-eyebrow">Bước 1 · Nhóm khách</div>
      <div style="display:flex; align-items:center; gap:10px; margin-top:8px;">
        <span style="font-size:24px;"><%= MemberSegments.icon(@segment) %></span>
        <div style="flex:1;">
          <div style="font-weight:700;"><%= MemberSegments.label(@segment) %></div>
          <div style="font-size:13px; color:var(--ink-2);">Sẽ gửi tới <strong><%= @count %></strong> khách</div>
        </div>
        <%= link_to "Đổi nhóm", merchant_customers_path, class: "l-chip" %>
      </div>
      <%= f.hidden_field :segment_key, value: @segment %>
    </div>

    <div class="l-panel" style="margin-bottom:16px;">
      <div class="l-eyebrow">Bước 2 · Nội dung</div>
      <label class="l-label" style="margin-top:8px;">Tiêu đề</label>
      <%= f.text_field :title, class: "l-field", required: true, placeholder: "Ưu đãi dành riêng cho bạn 🎁",
            data: { campaign_preview_target: "title", action: "input->campaign-preview#update" } %>
      <label class="l-label" style="margin-top:12px;">Nội dung</label>
      <%= f.text_area :body, class: "l-field", rows: 3, required: true, placeholder: "Ghé cửa hàng tuần này để nhận…",
            data: { campaign_preview_target: "body", action: "input->campaign-preview#update" } %>
    </div>

    <% if @count.to_i.zero? %>
      <div class="l-chip" style="background:#F7E0DA; color:#B4402F;">Nhóm khách này chưa có ai — hãy chọn nhóm khác để gửi.</div>
    <% else %>
      <%= f.submit "Gửi thông báo ngay", class: "l-btn l-btn-primary",
            data: { turbo_confirm: "Gửi tới #{@count} khách?" } %>
    <% end %>
  <% end %>

  <div style="position:sticky; top:90px;">
    <div class="l-eyebrow" style="margin-bottom:8px;">Bước 3 · Xem trước</div>
    <div class="l-tile">
      <div style="display:flex; gap:12px;">
        <div style="width:42px; height:42px; border-radius:14px; background:var(--primary); color:#fff; display:grid; place-items:center; font-size:20px; flex:none;">🎁</div>
        <div style="flex:1; min-width:0;">
          <div data-campaign-preview-target="pvTitle" style="font-weight:700;">Tiêu đề thông báo</div>
          <div data-campaign-preview-target="pvBody" style="font-size:13px; color:var(--ink-2); margin-top:2px;">Nội dung hiển thị ở đây…</div>
          <div style="font-size:11px; color:var(--ink-2); margin-top:6px;">vừa xong · <%= current_workspace.name %></div>
        </div>
      </div>
    </div>
  </div>
</div>
