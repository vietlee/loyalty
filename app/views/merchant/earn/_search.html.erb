<% if local_assigns[:error] || @error %>
  <div class="l-chip" style="background:#F3DDD7; color:#B4402F; margin-bottom:14px;">⚠ <%= @error %></div>
<% end %>

<div data-controller="scanner">
  <div style="position:relative; aspect-ratio:1; border-radius:16px; overflow:hidden; background:#111; display:grid; place-items:center;">
    <video data-scanner-target="video" playsinline muted style="width:100%; height:100%; object-fit:cover;"></video>
    <div data-scanner-target="overlay" style="position:absolute; inset:0; display:grid; place-items:center; color:#fff; text-align:center; padding:20px;">
      <div>
        <div style="font-size:40px;">⧉</div>
        <p style="font-size:13px; opacity:.85;">Quét mã QR của khách để tích điểm</p>
        <button type="button" class="l-btn l-btn-primary" style="margin-top:10px;" data-action="scanner#start">Bật camera</button>
      </div>
    </div>
    <div style="position:absolute; inset:18%; border:3px solid rgba(255,255,255,.7); border-radius:16px; pointer-events:none;"></div>
  </div>
  <p data-scanner-target="status" style="text-align:center; color:var(--ink-2); font-size:12px; margin-top:8px;"></p>

  <%= form_with url: merchant_earn_lookup_path, method: :post, data: { scanner_target: "form" } do %>
    <input type="hidden" name="token" data-scanner-target="token">
  <% end %>
</div>

<div style="display:flex; align-items:center; gap:10px; margin:16px 0; color:var(--ink-2); font-size:13px;">
  <span style="flex:1; height:1px; background:var(--line);"></span> hoặc nhập mã thủ công <span style="flex:1; height:1px; background:var(--line);"></span>
</div>

<%= form_with url: merchant_earn_lookup_path, method: :post do %>
  <div style="display:flex; gap:8px;">
    <input name="phone" inputmode="numeric" class="l-field" placeholder="Số điện thoại khách" autocomplete="off">
    <%= submit_tag "Tìm khách", class: "l-btn l-btn-primary", style: "white-space:nowrap;" %>
  </div>
<% end %>
