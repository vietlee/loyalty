<% content_for :title, "Nhân viên & phân quyền" %>
<% content_for :title_en, "STAFF" %>

<div style="display:grid; grid-template-columns:1fr 340px; gap:20px; align-items:start;">
  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Đội ngũ</h3>
    <% @memberships.each do |m| %>
      <div style="display:flex; align-items:center; gap:12px; padding:12px 0; border-top:1px solid var(--line);">
        <div class="l-avatar" style="width:38px; height:38px; border-radius:11px; background:var(--surface-2); display:grid; place-items:center; font-weight:600;"><%= m.user.initials %></div>
        <div style="flex:1; min-width:0;">
          <div style="font-weight:600;"><%= m.user.name %></div>
          <div style="font-size:12px; color:var(--ink-2);"><%= m.user.email %><%= " · #{m.outlet.name}" if m.outlet %></div>
        </div>
        <%= form_with url: merchant_staff_path(m), method: :patch, style: "display:flex; gap:6px;" do %>
          <select name="role" class="l-field" style="padding:6px 10px; font-size:13px;" onchange="this.form.requestSubmit()">
            <% Membership::ROLES.each do |r| %>
              <option value="<%= r %>" <%= "selected" if m.role == r %>><%= { "owner" => "Chủ", "manager" => "Quản lý", "staff" => "Nhân viên", "cashier" => "Thu ngân" }[r] %></option>
            <% end %>
          </select>
        <% end %>
        <%= button_to "✕", merchant_staff_path(m), method: :delete, class: "l-btn l-btn-ghost", style: "padding:6px 10px;", form: { data: { turbo_confirm: "Gỡ nhân viên này?" } } %>
      </div>
    <% end %>
  </div>

  <div class="l-panel" style="position:sticky; top:90px;">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Mời nhân viên</h3>
    <%= form_with url: merchant_staff_index_path, method: :post do %>
      <label class="l-label">Email</label>
      <%= email_field_tag :email, nil, class: "l-field", placeholder: "nhanvien@email.com" %>
      <label class="l-label" style="margin-top:12px;">Tên hiển thị</label>
      <%= text_field_tag :name, nil, class: "l-field", placeholder: "Tên nhân viên" %>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
        <div>
          <label class="l-label">Vai trò</label>
          <%= select_tag :role, options_for_select([["Thu ngân", "cashier"], ["Nhân viên", "staff"], ["Quản lý", "manager"]], "staff"), class: "l-field" %>
        </div>
        <div>
          <label class="l-label">Chi nhánh</label>
          <%= select_tag :outlet_id, options_from_collection_for_select(@outlets, :id, :name), include_blank: "—", class: "l-field" %>
        </div>
      </div>
      <%= submit_tag "Gửi lời mời", class: "l-btn l-btn-primary", style: "margin-top:14px;" %>
    <% end %>
    <p style="font-size:12px; color:var(--ink-2); margin-top:10px;">Nhân viên đăng nhập tại <span class="l-mono">/merchant/login</span> bằng email được mời.</p>
  </div>
</div>
