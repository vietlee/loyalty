<% content_for :title, "Tổng quan" %>
<% content_for :title_en, "DASHBOARD" %>

<% if @sub_warning %>
  <% w = @sub_warning %>
  <div class="l-subwarn <%= w[:level] %>">
    <div style="flex:1;">
      <strong><%= { expired: "Thuê bao đã hết hạn", expiring: "Thuê bao sắp hết hạn", inactive: "Chưa kích hoạt thuê bao" }[w[:kind]] %></strong>
      <div style="font-size:13px; opacity:.9; margin-top:2px; max-width:760px;">
        <% if w[:kind] == :expired %>
          Vui lòng thanh toán trong <strong><%= w[:days] %> ngày</strong> tới. Quá <strong>10 ngày</strong> kể từ ngày hết hạn mà chưa thanh toán, cửa hàng sẽ <strong>tự động ngưng hoạt động (inactive)</strong> và không thể sử dụng dịch vụ cho đến khi thanh toán.
        <% elsif w[:kind] == :expiring %>
          Còn <strong><%= w[:days] %> ngày</strong> là đến hạn — gia hạn sớm để không gián đoạn. Nếu để quá <strong>10 ngày</strong> sau khi hết hạn mà chưa thanh toán, cửa hàng sẽ tự động ngưng hoạt động.
        <% else %>
          Vui lòng thanh toán để kích hoạt đầy đủ dịch vụ. Trong vòng <strong>10 ngày</strong> kể từ ngày hết hạn, nếu chưa thanh toán cửa hàng sẽ <strong>tự động ngưng hoạt động (inactive)</strong> và không thể sử dụng dịch vụ.
        <% end %>
      </div>
    </div>
    <%= link_to "Thanh toán ngay", merchant_billing_path, class: "l-btn l-btn-primary", style: "flex:none;" %>
  </div>
<% end %>

<%# ---- KPI strip ---- %>
<div class="l-kpis">
  <div class="l-kpi"><div class="k">Thành viên</div><div class="v"><%= number_with_delimiter(@members_count) %></div><div class="d"><%= number_with_delimiter(@active_members) %> đang hoạt động</div></div>
  <div class="l-kpi"><div class="k">Điểm đã phát</div><div class="v"><%= number_with_delimiter(@points_issued) %></div><div class="d"><%= @purchases_count %> giao dịch</div></div>
  <div class="l-kpi"><div class="k">Điểm đã đổi</div><div class="v"><%= number_with_delimiter(@points_redeemed) %></div><div class="d">tỷ lệ đổi <%= @redemption_rate %>%</div></div>
  <div class="l-kpi"><div class="k">Chi nhánh</div><div class="v"><%= @outlets_count %></div><div class="d">outlets</div></div>
</div>

<%# ---- Growth chart + loyalty snapshot ---- %>
<div style="display:grid; grid-template-columns:1.5fr 1fr; gap:16px; margin-top:20px;">
  <div class="l-panel">
    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:6px;">
      <div>
        <h3 class="l-display" style="font-size:18px;">Khách hàng mới theo tháng</h3>
        <p style="color:var(--ink-2); font-size:13px;">6 tháng gần nhất</p>
      </div>
      <div style="text-align:right;">
        <div class="l-num" style="font-size:24px;"><%= number_with_delimiter(@members_count) %></div>
        <div style="color:var(--ink-2); font-size:12px;">tổng thành viên</div>
      </div>
    </div>
    <div style="color:var(--primary); margin-top:10px;">
      <%= bar_chart_svg(@member_growth) %>
    </div>
  </div>

  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Bức tranh loyalty</h3>
    <% total_tiered = @tier_counts.sum { |_, c| c } %>
    <% if total_tiered.positive? %>
      <div style="display:flex; flex-direction:column; gap:12px;">
        <% @tier_counts.each do |t, c| %>
          <% pct = (c.to_f / total_tiered * 100).round %>
          <div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:4px;">
              <span style="font-weight:600;"><%= t.name %></span>
              <span style="color:var(--ink-2);"><%= number_with_delimiter(c) %> · <%= pct %>%</span>
            </div>
            <div style="height:8px; border-radius:999px; background:var(--surface-2); overflow:hidden;">
              <div style="height:100%; width:<%= pct %>%; border-radius:999px; background:<%= t.gradient_css %>;"></div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p style="color:var(--ink-2); font-size:13px;">Chưa có dữ liệu hạng thành viên.</p>
    <% end %>
    <div style="display:flex; gap:10px; margin-top:16px; padding-top:14px; border-top:1px solid var(--line);">
      <div style="flex:1;"><div class="l-num" style="font-size:20px;"><%= @redemption_rate %>%</div><div style="font-size:11px; color:var(--ink-2);">Tỷ lệ đổi điểm</div></div>
      <div style="flex:1;"><div class="l-num" style="font-size:20px;"><%= @members_count.positive? ? number_with_delimiter((@points_issued / @members_count)) : 0 %></div><div style="font-size:11px; color:var(--ink-2);">Điểm TB/khách</div></div>
    </div>
  </div>
</div>

<%# ---- Per-branch performance ---- %>
<% if @outlet_stats&.any? %>
  <% max_rev = [@outlet_stats.map { |r| r[:revenue] }.max, 1].max %>
  <div class="l-panel" style="margin-top:16px;">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;">Hiệu suất theo chi nhánh</h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:14px;">Doanh thu ghi nhận qua tích điểm, xếp theo chi nhánh.</p>
    <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:13.5px; min-width:560px;">
        <thead><tr style="text-align:left; color:var(--ink-2); font-size:11px; text-transform:uppercase; letter-spacing:.06em;">
          <th style="padding:8px 10px;">Chi nhánh</th>
          <th style="text-align:right;">Doanh thu</th>
          <th style="text-align:right;">Điểm phát</th>
          <th style="text-align:right;">Giao dịch</th>
          <th style="text-align:right;">Khách</th>
          <th style="text-align:right;">Ưu đãi dùng</th>
        </tr></thead>
        <tbody>
          <% @outlet_stats.each do |r| %>
            <tr style="border-top:1px solid var(--line);">
              <td style="padding:11px 10px; min-width:180px;">
                <div style="font-weight:600;"><%= r[:name] %></div>
                <div style="height:6px; border-radius:999px; background:var(--surface-2); overflow:hidden; margin-top:5px;">
                  <div style="height:100%; width:<%= (r[:revenue].to_f / max_rev * 100).round %>%; background:var(--primary); border-radius:999px;"></div>
                </div>
              </td>
              <td style="text-align:right; font-weight:700; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:revenue]) %>đ</td>
              <td style="text-align:right; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:points]) %></td>
              <td style="text-align:right; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:purchases]) %></td>
              <td style="text-align:right; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:customers]) %></td>
              <td style="text-align:right; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:vouchers]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<%# ---- Program mechanisms + check-in QR ---- %>
<div style="display:grid; grid-template-columns:1.5fr 1fr; gap:16px; margin-top:16px;">
  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;">Chương trình loyalty</h3>
    <p style="color:var(--ink-2); font-size:14px; margin-bottom:16px;">Cơ chế đang bật cho workspace này.</p>
    <% if @program %>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <% { "Points" => @program.points_enabled, "Tiers" => @program.tiers_enabled, "Stamp" => @program.stamps_enabled, "Gamification" => @program.gamification_enabled }.each do |label, on| %>
          <span class="l-chip <%= 'l-chip-brand' if on %>"><%= on ? "●" : "○" %> <%= label %></span>
        <% end %>
      </div>
      <p style="margin-top:16px; color:var(--ink-2);">Tỷ lệ tích điểm: <strong><%= @program.earn_rate_label %></strong></p>
      <%= link_to "Cấu hình chương trình →", merchant_loyalty_program_path, class: "l-btn l-btn-soft", style: "margin-top:16px;" %>
    <% end %>
  </div>

  <% if @has_checkin %>
    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:4px;">Mã check-in tại quầy</h3>
      <div style="display:flex; gap:14px; align-items:center; margin-top:10px;">
        <div style="background:#fff; padding:10px; border:1px solid var(--line); border-radius:14px; flex:none;">
          <%= qr_svg(@checkin_url, size: 104) %>
        </div>
        <p style="color:var(--ink-2); font-size:12.5px;">
          In &amp; dán tại quầy. Khách quét để check-in nhận điểm — 1 lần/ngày.
        </p>
      </div>
      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:12px;">
        <%= link_to merchant_checkin_qr_path, class: "l-btn l-btn-soft" do %>
          <%= ui_icon(:launch, size: 16) %> Tải mã để in
        <% end %>
        <% if current_membership&.can_manage? %>
          <%= button_to merchant_rotate_checkin_path, method: :post, class: "l-btn l-btn-ghost",
                form: { data: { turbo_confirm: "Làm mới mã sẽ khiến mã đã in trước đó ngừng hoạt động. Tiếp tục?" } } do %>
            <%= ui_icon(:history, size: 16) %> Làm mới mã
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:10px;">Hạng thành viên</h3>
      <% @tiers.each do |t| %>
        <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--line);">
          <span style="width:26px; height:26px; border-radius:8px; background:<%= t.gradient_css %>;"></span>
          <strong><%= t.name %></strong>
          <span style="margin-left:auto; color:var(--ink-2);"><%= number_with_delimiter(t.threshold_points) %> điểm</span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
