<% content_for :title, @outlet.name %>
<% content_for :title_en, "OUTLET" %>

<div style="max-width:960px;">
  <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
    <%= link_to "←", merchant_outlets_path, class: "l-btn l-btn-ghost", style: "padding:6px 12px;" %>
    <div>
      <h2 class="l-display" style="font-size:24px;"><%= @outlet.name %></h2>
      <% if @outlet.address.present? %><div style="color:var(--ink-2); font-size:13px;">📍 <%= @outlet.address %></div><% end %>
    </div>
  </div>

  <div class="l-kpis">
    <div class="l-kpi"><div class="k">Doanh thu</div><div class="v"><%= number_with_delimiter(@revenue) %>đ</div><div class="d"><%= @purchases %> giao dịch</div></div>
    <div class="l-kpi"><div class="k">Điểm đã phát</div><div class="v"><%= number_with_delimiter(@points) %></div></div>
    <div class="l-kpi"><div class="k">Khách đã ghé</div><div class="v"><%= number_with_delimiter(@customers) %></div></div>
    <div class="l-kpi"><div class="k">Ưu đãi đã dùng</div><div class="v"><%= number_with_delimiter(@vouchers) %></div></div>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1.4fr; gap:16px; margin-top:20px;">
    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:10px;">Nhân viên chi nhánh</h3>
      <% if @staff.any? %>
        <% @staff.each do |m| %>
          <div style="display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid var(--line);">
            <span class="av" style="width:32px; height:32px; border-radius:9px; background:var(--surface-2); display:grid; place-items:center; font-size:12px; font-weight:600;"><%= m.user&.initials %></span>
            <div style="flex:1; min-width:0;">
              <div style="font-weight:600; font-size:14px;"><%= m.user&.name %></div>
              <div style="font-size:12px; color:var(--ink-2);"><%= m.user&.email %></div>
            </div>
            <span class="l-chip"><%= m.label %></span>
          </div>
        <% end %>
      <% else %>
        <p style="color:var(--ink-2); font-size:13px;">Chưa gán nhân viên cho chi nhánh này. <%= link_to "Thêm ở trang Nhân viên", merchant_staff_index_path, style: "color:var(--primary-ink);" %>.</p>
      <% end %>
    </div>

    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:10px;">Giao dịch gần đây</h3>
      <% if @recent.any? %>
        <table style="width:100%; border-collapse:collapse; font-size:13.5px;">
          <% @recent.each do |tx| %>
            <tr style="border-top:1px solid var(--line);">
              <td style="padding:9px 4px;"><%= tx.member&.display_name %></td>
              <td style="color:var(--ink-2);"><%= tx.title %></td>
              <td style="text-align:right; color:var(--ink-2); white-space:nowrap;"><%= l(tx.created_at, format: :short) %></td>
              <td class="l-num" style="text-align:right; color:<%= tx.credit? ? 'var(--good)' : 'var(--warn)' %>;"><%= tx.credit? ? "+" : "" %><%= number_with_delimiter(tx.amount) %></td>
            </tr>
          <% end %>
        </table>
      <% else %>
        <p style="color:var(--ink-2); font-size:13px;">Chưa có giao dịch nào tại chi nhánh này.</p>
      <% end %>
    </div>
  </div>

  <% if @has_checkin %>
    <div class="l-panel" style="margin-top:16px; display:flex; gap:18px; align-items:center; flex-wrap:wrap;">
      <%= render "merchant/shared/qr_zoom", url: @checkin_url, size: 120,
            title: "Mã check-in — #{@outlet.name}",
            note: "Khách quét mã này sẽ được ghi nhận check-in đúng #{@outlet.name}." %>
      <div style="flex:1; min-width:220px;">
        <h3 class="l-display" style="font-size:17px; margin-bottom:4px;">Mã check-in của chi nhánh này</h3>
        <p style="color:var(--ink-2); font-size:13px; margin-bottom:12px;">In &amp; dán tại <strong><%= @outlet.name %></strong>, hoặc <strong>nhấn vào mã</strong> để phóng to. Khách quét sẽ được ghi nhận check-in đúng chi nhánh này.</p>
        <%= link_to checkin_qr_merchant_outlet_path(@outlet), class: "l-btn l-btn-soft" do %>
          <%= ui_icon(:launch, size: 16) %> Tải mã để in
        <% end %>
      </div>
    </div>
  <% end %>
</div>
