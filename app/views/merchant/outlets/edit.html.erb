<% content_for :title, "Sửa chi nhánh" %>
<% content_for :title_en, "EDIT OUTLET" %>
<div class="l-panel" style="max-width:480px;">
  <%= form_with model: @outlet, url: merchant_outlet_path(@outlet), method: :patch do |f| %>
    <label class="l-label">Tên chi nhánh</label>
    <%= f.text_field :name, class: "l-field" %>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
      <div><label class="l-label">Mã</label><%= f.text_field :code, class: "l-field" %></div>
      <div><label class="l-label">SĐT</label><%= f.telephone_field :phone, class: "l-field" %></div>
    </div>
    <label class="l-label" style="margin-top:12px;">Địa chỉ</label>
    <%= f.text_field :address, class: "l-field" %>
    <label style="display:flex; align-items:center; gap:8px; margin-top:12px; font-size:14px;">
      <%= f.check_box :active %> Đang hoạt động
    </label>
    <div style="display:flex; gap:10px; margin-top:16px;">
      <%= link_to "Huỷ", merchant_outlets_path, class: "l-btn l-btn-ghost" %>
      <%= f.submit "Lưu", class: "l-btn l-btn-primary", style: "flex:1;" %>
    </div>
  <% end %>
</div>
