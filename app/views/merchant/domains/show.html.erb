<% content_for :title, t("merchant.nav.domain") %>
<% content_for :title_en, "DOMAIN" %>
<% ws = @workspace %>

<div style="max-width:680px;">
  <div class="l-panel" style="margin-bottom:16px;">
    <div class="l-eyebrow"><%= t("merchant.domain.default") %></div>
    <div style="display:flex; align-items:center; gap:10px; margin-top:8px;">
      <span class="l-mono" style="font-size:18px; font-weight:700;"><%= @default_host %></span>
      <span class="l-chip" style="background:var(--good)22; color:var(--good);"><%= t("merchant.domain.ready") %></span>
    </div>
    <p style="color:var(--ink-2); font-size:13px; margin-top:8px;"><%= t("merchant.domain.default_note") %></p>
  </div>

  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;"><%= t("merchant.domain.custom_title") %></h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:14px;"><%= t("merchant.domain.custom_note_html").html_safe %></p>

    <div style="display:flex; align-items:center; gap:12px; padding:14px 16px; border-radius:14px; background:var(--surface-2);">
      <span class="l-chip" style="background:var(--primary)22; color:var(--primary-ink); font-weight:600; flex:none;"><%= t("merchant.domain.soon") %></span>
      <p style="font-size:13px; color:var(--ink-2); margin:0;"><%= t("merchant.domain.soon_note") %></p>
    </div>
  </div>
</div>
