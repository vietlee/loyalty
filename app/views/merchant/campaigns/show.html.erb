<% content_for :title, @campaign.name %>
<% content_for :title_en, "CAMPAIGN" %>

<div style="margin-bottom:14px;">
  <%= link_to t("merchant.campaigns.back"), merchant_campaigns_path, style: "color:var(--ink-2); font-size:13px; text-decoration:none;" %>
</div>
<%# Static metadata (not clickable): plain labels with dot separators %>
<div style="display:flex; align-items:center; gap:8px; margin-bottom:16px; flex-wrap:wrap; color:var(--ink-2); font-size:13px;">
  <span><%= @campaign.type_label %></span>
  <span style="opacity:.5;">·</span>
  <span style="display:inline-flex; align-items:center; gap:6px; font-weight:700; color:<%= @campaign.status == 'running' ? 'var(--good)' : 'var(--ink)' %>;">
    <% if @campaign.status == "running" %><span style="width:7px; height:7px; border-radius:50%; background:var(--good); display:inline-block;"></span><% end %>
    <%= @campaign.status_label %>
  </span>
  <span style="opacity:.5;">·</span>
  <span><%= @campaign.audience_label %></span>
</div>

<% if current_membership&.can_manage? %>
  <div style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
    <% if @campaign.status == "running" %>
      <%= button_to "⏸ Tạm dừng", pause_merchant_campaign_path(@campaign), method: :patch,
            class: "l-btn l-btn-soft", style: "border-color:color-mix(in srgb, var(--btn-primary) 32%, transparent);", form: { style: "display:inline;" } %>
    <% elsif @campaign.status == "paused" %>
      <%= button_to "▶ Tiếp tục", resume_merchant_campaign_path(@campaign), method: :patch,
            class: "l-btn l-btn-primary", form: { style: "display:inline;" } %>
    <% end %>
    <%= button_to "🗑 Xoá chiến dịch", merchant_campaign_path(@campaign), method: :delete,
          class: "l-btn l-btn-ghost", style: "color:var(--warn); border-color:color-mix(in srgb, var(--warn) 45%, var(--line));",
          form: { style: "display:inline;", data: { turbo_confirm: "Xoá chiến dịch này? Mã QR phát hành sẽ ngừng hoạt động. Voucher đã phát cho khách vẫn được giữ." } } %>
  </div>
<% end %>

<div style="display:grid; grid-template-columns:<%= @promo ? '1fr 360px' : '1fr' %>; gap:20px; align-items:start;">
  <div class="l-panel">
    <h2 class="l-display" style="font-size:22px;"><%= @campaign.name %></h2>
    <% if @campaign.content_value("title").present? %>
      <p style="font-weight:600; margin-top:10px;"><%= @campaign.content_value("title") %></p>
      <p style="color:var(--ink-2); font-size:14px;"><%= @campaign.content_value("body") %></p>
    <% end %>
    <% if @campaign.reward %>
      <div class="l-ticket" style="margin-top:16px; max-width:420px;">
        <div class="stub"><div class="v"><%= @campaign.reward.value_label %></div><div class="u"><%= @campaign.reward.kind %></div></div>
        <div class="perf"></div>
        <div class="body"><div style="font-weight:700;"><%= @campaign.reward.display_icon %> <%= @campaign.reward.title %></div></div>
      </div>
    <% end %>
    <div style="margin-top:16px; color:var(--ink-2); font-size:13px;">
      <%= t("merchant.campaigns.time") %>: <%= @campaign.starts_at ? l(@campaign.starts_at, format: :short) : "—" %> → <%= @campaign.ends_at ? l(@campaign.ends_at, format: :short) : t("merchant.campaigns.unlimited") %>
    </div>
  </div>

  <% if @promo %>
    <div>
      <div class="l-panel" style="text-align:center;">
        <div class="l-eyebrow"><%= t("merchant.campaigns.promo_qr") %></div>
        <div style="display:inline-block; padding:14px; background:#fff; border:1px solid var(--line); border-radius:16px; margin-top:8px;">
          <%= qr_svg(@promo_url, color: "1A1A1A", size: 190) %>
        </div>
        <div class="l-mono" style="margin-top:8px; font-size:13px;"><%= @promo.token %></div>
        <%= link_to t("merchant.campaigns.download_svg"), qr_merchant_campaign_path(@campaign), class: "l-btn l-btn-soft l-btn-block", style: "margin-top:12px;", data: { turbo: false } %>
        <p style="font-size:12px; color:var(--ink-2); margin-top:8px;"><%= t("merchant.campaigns.promo_note") %></p>
      </div>

      <div class="l-panel" style="margin-top:16px;">
        <div class="l-eyebrow" style="margin-bottom:10px;"><%= t("merchant.campaigns.effectiveness") %></div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div><div class="l-num" style="font-size:26px;"><%= @promo.scan_count %></div><div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.campaigns.scan_count") %></div></div>
          <div><div class="l-num" style="font-size:26px;"><%= @promo.claims_count %></div><div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.campaigns.claimed") %><%= " / #{@promo.max_claims}" if @promo.max_claims %></div></div>
          <div><div class="l-num" style="font-size:26px;"><%= @promo.used_count %></div><div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.campaigns.used") %></div></div>
          <div><div class="l-num" style="font-size:26px;"><%= @promo.use_rate %>%</div><div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.campaigns.use_rate") %></div></div>
        </div>
        <% if @promo.remaining %>
          <div style="margin-top:12px; height:8px; border-radius:999px; background:var(--surface-2); overflow:hidden;">
            <div style="height:100%; width:<%= @promo.max_claims.zero? ? 0 : (@promo.claims_count.to_f / @promo.max_claims * 100).round %>%; background:var(--primary);"></div>
          </div>
          <div style="font-size:12px; color:var(--ink-2); margin-top:6px;"><%= t("merchant.campaigns.remaining", a: @promo.remaining, b: @promo.max_claims) %></div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
